---
// Carrusel de diapositivas: desplazamiento lateral con el dedo (scroll-snap), flechas en escritorio y puntos de posición.
// Cada hijo directo del slot es una diapositiva.
interface Props {
  etiqueta: string;
  titulos: string[];
}
const { etiqueta, titulos } = Astro.props;
---

<section class="carrusel" aria-roledescription="carrusel" aria-label={etiqueta} data-carrusel>
  <div class="cabecera-carrusel">
    <div class="puntos-carrusel" role="tablist" aria-label="Elegir gráfico">
      {titulos.map((t, i) => (
        <button type="button" role="tab" aria-selected={String(i === 0)} aria-label={`${i + 1} de ${titulos.length}: ${t}`} data-ir={i}>
          <span>{t}</span>
        </button>
      ))}
    </div>
    <div class="flechas" aria-hidden="true">
      <button type="button" tabindex="-1" data-mover="-1" class="flecha izq"></button>
      <button type="button" tabindex="-1" data-mover="1" class="flecha der"></button>
    </div>
  </div>
  <div class="pista-carrusel" data-pista>
    <slot />
  </div>
</section>

<script>
  function iniciar() {
    document.querySelectorAll<HTMLElement>('[data-carrusel]').forEach((c) => {
      const pista = c.querySelector<HTMLElement>('[data-pista]')!;
      // Los <script> y <style> de los componentes pueden quedar dentro de la pista: no son diapositivas
      const diapos = ([...pista.children] as HTMLElement[]).filter((el) => !['SCRIPT', 'STYLE'].includes(el.tagName));
      const pestanas = [...c.querySelectorAll<HTMLButtonElement>('[data-ir]')];
      let actual = 0;

      diapos.forEach((d, i) => {
        d.setAttribute('role', 'group');
        d.setAttribute('aria-roledescription', 'diapositiva');
        d.setAttribute('aria-label', `${i + 1} de ${diapos.length}`);
      });

      // La altura del carrusel sigue a la diapositiva visible, para no dejar huecos
      const ajustarAltura = () => (pista.style.height = `${diapos[actual].offsetHeight}px`);
      const marcar = (i: number) => {
        actual = i;
        pestanas.forEach((p, j) => p.setAttribute('aria-selected', String(j === i)));
        diapos.forEach((d, j) => d.toggleAttribute('inert', j !== i));
        ajustarAltura();
      };
      const ir = (i: number) => {
        const destino = Math.max(0, Math.min(diapos.length - 1, i));
        pista.scrollTo({ left: diapos[destino].offsetLeft - pista.offsetLeft, behavior: 'smooth' });
        marcar(destino);
      };

      pestanas.forEach((p) => p.addEventListener('click', () => ir(Number(p.dataset.ir))));
      c.querySelectorAll<HTMLButtonElement>('[data-mover]').forEach((b) =>
        b.addEventListener('click', () => ir(actual + Number(b.dataset.mover))),
      );
      // Al deslizar con el dedo, la diapositiva actual se calcula por la posición del desplazamiento
      let temporizador: ReturnType<typeof setTimeout>;
      pista.addEventListener(
        'scroll',
        () => {
          clearTimeout(temporizador);
          temporizador = setTimeout(() => {
            const i = Math.round(pista.scrollLeft / pista.clientWidth);
            if (i !== actual) marcar(Math.max(0, Math.min(diapos.length - 1, i)));
          }, 80);
        },
        { passive: true },
      );
      // Si cambia el contenido de una diapositiva (p. ej. al abrir un desplegable), se recalcula la altura
      diapos.forEach((d) => new ResizeObserver(() => d === diapos[actual] && ajustarAltura()).observe(d));
      marcar(0);
    });
  }
  document.addEventListener('astro:page-load', iniciar);
</script>

<style>
  .carrusel { margin-top: 40px; border-top: 1px solid var(--tinta); padding-top: 12px; }
  .cabecera-carrusel { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 4px; }
  .puntos-carrusel { display: flex; gap: 6px; flex-wrap: wrap; }
  .puntos-carrusel button {
    font: inherit;
    font-size: 13px;
    padding: 6px 12px;
    border-radius: 999px;
    border: 1px solid var(--linea);
    background: transparent;
    color: var(--suave);
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s, border-color 0.2s;
  }
  .puntos-carrusel button[aria-selected='true'] { background: var(--tinta); color: var(--papel); border-color: var(--tinta); }
  .flechas { display: none; gap: 6px; }
  .flecha { width: 34px; height: 34px; border-radius: 50%; border: 1px solid var(--linea); background: transparent; cursor: pointer; position: relative; }
  .flecha::after { content: ''; position: absolute; top: 50%; left: 50%; width: 8px; height: 8px; border-top: 1.5px solid var(--tinta); border-right: 1.5px solid var(--tinta); }
  .flecha.izq::after { transform: translate(-30%, -50%) rotate(-135deg); }
  .flecha.der::after { transform: translate(-70%, -50%) rotate(45deg); }
  .flecha:hover { border-color: var(--suave); }

  .pista-carrusel {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
    align-items: flex-start;
    transition: height 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .pista-carrusel::-webkit-scrollbar { display: none; }
  .pista-carrusel > :global(*) { flex: 0 0 100%; scroll-snap-align: start; min-width: 0; }
  /* Dentro del carrusel, cada gráfico pierde su separador propio */
  .pista-carrusel > :global(section) { margin-top: 0; border-top: 0; padding-top: 0; }
  /* Botones de los gráficos en varias líneas: así no compiten con el gesto de deslizar */
  .pista-carrusel :global(.elegir) { flex-wrap: wrap; margin-inline: 0; padding-inline: 0; overflow: visible; }
  @media (min-width: 640px) {
    .flechas { display: flex; }
  }
</style>
