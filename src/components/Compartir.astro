---
// Botón de compartir: abre el menú del propio móvil (Web Share API) o, si no lo hay, copia el enlace
interface Props {
  titulo: string;
  // Sección de la página a la que apunta el enlace (id), si no es la página entera
  ancla?: string;
}
const { titulo, ancla } = Astro.props;
---

<button type="button" class="compartir" data-compartir data-titulo={titulo} data-ancla={ancla}>
  <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M8 10V2M5 5l3-3 3 3M3 9v4h10V9" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
  <span data-compartir-texto>Compartir</span>
</button>

<script>
  // Un único escuchador para todos los botones, también los de páginas a las que se llega navegando
  document.addEventListener('click', async (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-compartir]');
    if (!b) return;
    const url = `${location.origin}${location.pathname}${b.dataset.ancla ? `#${b.dataset.ancla}` : ''}`;
    const titulo = b.dataset.titulo!;
    if (navigator.share) {
      try {
        await navigator.share({ title: titulo, url });
      } catch {}
      return;
    }
    const texto = b.querySelector('[data-compartir-texto]')!;
    try {
      await navigator.clipboard.writeText(url);
      texto.textContent = 'Enlace copiado';
    } catch {
      texto.textContent = 'No se pudo copiar';
    }
    setTimeout(() => (texto.textContent = 'Compartir'), 2000);
  });
</script>

<style>
  .compartir {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 40px;
    padding: 0 14px;
    font: inherit;
    font-size: 14px;
    color: var(--tinta);
    background: transparent;
    border: 1px solid var(--linea);
    border-radius: 999px;
    cursor: pointer;
    transition: border-color 0.15s;
  }
  .compartir:hover { border-color: var(--suave); }
</style>
