---
import { FUENTES, type IdFuente } from '../lib/fuentes';

interface Props {
  // Una o varias fuentes
  de: IdFuente | IdFuente[];
  // Cifra calculada por nosotros a partir de esas fuentes
  calculo?: boolean;
  // Precisión tras el enlace, p. ej. "art. 86"
  detalle?: string;
}
const { de, calculo = false, detalle } = Astro.props;
const lista = (Array.isArray(de) ? de : [de]).map((id) => FUENTES[id]);
---

<span class="fuente">
  {calculo ? 'Cálculo propio con datos de ' : 'Fuente: '}
  {lista.map((f, i) => (
    <>
      {i > 0 && (i === lista.length - 1 ? ' y ' : ', ')}
      <a href={f.url} target="_blank" rel="noopener">{f.nombre}</a>
    </>
  ))}
  {detalle && `, ${detalle}`}
</span>

<style>
  .fuente { display: block; margin-top: 4px; font-size: 11px; line-height: 1.4; color: var(--suave); }
  .fuente a { color: var(--suave); }
  .fuente a:hover { color: var(--tinta); }
</style>
