---
import votaciones from '../data/votaciones.json';
import programas from '../data/programas-2023.json';
import citas from '../data/votaciones-programas-2023.json';
import { color } from '../lib/partidos';

type Partido = keyof typeof programas;
// Grupo parlamentario de cada partido en la XV legislatura; mismo orden que el resto de gráficos (por tamaño)
const PARTIDOS: [Partido, string][] = [
  ['PP', 'GP'],
  ['PSOE', 'GS'],
  ['VOX', 'GVOX'],
  ['SUMAR', 'GSUMAR'],
];
const VOTO: Record<string, string> = { si: 'Sí', no: 'No', abstencion: 'Abstención', noVota: 'No votó', dividido: 'Dividido' };
const fecha = (f: string) => new Date(f + 'T12:00:00').toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });

const pares = PARTIDOS.map(([partido, grupo]) => ({
  partido,
  items: Object.entries(citas as Record<string, { partido: Partido; pagina: number; cita: string }[]>)
    .flatMap(([archivo, lista]) => {
      const v = votaciones.find((x) => x.id.replace('-', '/') + '.json' === archivo)!;
      return lista
        .filter((c) => c.partido === partido)
        .map((c) => ({ ...c, v, voto: v.grupos.find((g) => g.codigo === grupo)!.sentido }));
    })
    .sort((a, b) => b.v.fecha.localeCompare(a.v.fecha)),
}));
---

<section class="prometido" aria-labelledby="prometido-titulo">
  <h2 id="prometido-titulo">Lo prometido y lo votado</h2>
  <p>Promesas de los programas de 2023 y qué votó después cada partido cuando el Congreso votó algo sobre ese asunto.</p>

  <div class="elegir" role="tablist" aria-label="Elegir partido" data-prometido>
    {pares.map((p, i) => (
      <button type="button" role="tab" aria-selected={String(i === 0)} aria-controls={`prom-${i}`} data-i={i}>
        <span class="punto" style={`--c:${color(p.partido)}`}></span>{programas[p.partido].corto} · {p.items.length}
      </button>
    ))}
  </div>

  {pares.map((p, i) => (
    <ol class="items" id={`prom-${i}`} role="tabpanel" hidden={i !== 0}>
      {p.items.map((it) => (
        <li>
          <blockquote>«{it.cita}»</blockquote>
          <span class="fuente-nota">
            Fuente: <a href={`${programas[p.partido].url}#page=${it.pagina}`} target="_blank" rel="noopener">{programas[p.partido].titulo}, página {it.pagina}</a>
          </span>
          <div class="hecho">
            <p class="votacion"><a href={`#${it.v.id}`}>{it.v.nombre}</a> <span class="suave">· {fecha(it.v.fecha)}</span></p>
            <p>
              <span class="suave">Votó</span> <strong>{VOTO[it.voto]}</strong>
              <span class="suave"> · votar sí era {it.v.siSignifica} · ganó el {it.v.gana === 'si' ? 'sí' : 'no'}</span>
            </p>
          </div>
        </li>
      ))}
    </ol>
  ))}

  <p class="aviso-prometido suave">
    No es una medida de coherencia: un partido puede votar en contra de una iniciativa concreta aunque comparta el objetivo, por ejemplo
    porque propone otra forma de hacerlo. Solo mostramos promesas que coinciden con alguna de las votaciones de esta página.
  </p>
</section>

<script>
  function iniciar() {
    const tabs = document.querySelector<HTMLElement>('[data-prometido]');
    if (!tabs) return;
    const botones = [...tabs.querySelectorAll<HTMLButtonElement>('button')];
    botones.forEach((b) =>
      b.addEventListener('click', () => {
        botones.forEach((x) => x.setAttribute('aria-selected', String(x === b)));
        document.querySelectorAll<HTMLElement>('.prometido .items').forEach((p, i) => (p.hidden = String(i) !== b.dataset.i));
      }),
    );
  }
  document.addEventListener('astro:page-load', iniciar);
</script>

<style>
  .prometido h2 { margin: 0 0 6px; font-size: 28px; }
  .prometido > p { margin: 0; font-size: 15px; }
  .elegir { display: flex; gap: 8px; flex-wrap: wrap; margin: 16px 0 4px; }
  .elegir button {
    display: flex;
    align-items: center;
    font: inherit;
    font-size: 14px;
    padding: 7px 13px;
    border-radius: 999px;
    border: 1px solid var(--linea);
    background: transparent;
    color: var(--tinta);
    cursor: pointer;
    transition: background-color 0.15s, color 0.15s;
  }
  .elegir button[aria-selected='true'] { background: var(--tinta); color: var(--papel); border-color: var(--tinta); }
  .punto { width: 9px; height: 9px; border-radius: 50%; background: var(--c); margin-right: 8px; flex: none; }
  .elegir button[aria-selected='true'] .punto { box-shadow: 0 0 0 1.5px var(--papel); }

  .items { list-style: none; margin: 8px 0 0; padding: 0; }
  .items li { padding: 14px 0; border-bottom: 1px solid var(--linea); }
  blockquote { margin: 0; font-family: var(--serif); font-size: 19px; line-height: 1.3; }
  .fuente-nota { display: block; margin-top: 4px; font-size: 11px; color: var(--suave); }
  .fuente-nota a { color: var(--suave); }
  .hecho { margin-top: 10px; padding: 10px 12px; background: var(--resalte); border-radius: 10px; font-size: 14px; }
  .hecho p { margin: 0; }
  .hecho p + p { margin-top: 4px; }
  .hecho strong { font-weight: 600; }
  .votacion a { font-weight: 500; text-decoration: none; }
  .votacion a:hover { text-decoration: underline; }
  .aviso-prometido { font-size: 13px; margin: 12px 0 0; }
</style>
