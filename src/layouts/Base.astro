---
import '@fontsource-variable/instrument-sans';
import '@fontsource/instrument-serif';
import '@fontsource/instrument-serif/400-italic.css';
import { ClientRouter } from 'astro:transitions';
import actualizacion from '../data/actualizado.json';

interface Props {
  title: string;
  description?: string;
  // Imagen para compartir (1200×630), generada por scripts/og.mjs
  imagen?: string;
}
const {
  title,
  description = 'Qué proponen los partidos, qué votaron y cómo cuenta tu voto en tu provincia.',
  imagen = '/og/general.png',
} = Astro.props;
// Dominio de astro.config (site); en desarrollo, si falta, el del propio servidor
const base = Astro.site ?? Astro.url;
const url = new URL(Astro.url.pathname, base);
const imagenUrl = new URL(imagen, base);

const nav = [
  { href: '/tu-voto', texto: 'Tu voto' },
  { href: '/votaciones', texto: 'Votaciones' },
  { href: '/propuestas', texto: 'Propuestas' },
];
const actual = Astro.url.pathname;
// Fecha y hora del último cambio en la información (datos, propuestas, votaciones), no del último cambio de diseño.
// Se pone a mano en src/data/actualizado.json cada vez que cambia algún dato publicado
const publicado = new Date(actualizacion.fecha);
const madrid = { timeZone: 'Europe/Madrid' } as const;
const actualizado = `${publicado.toLocaleDateString('es-ES', { ...madrid, day: 'numeric', month: 'short' }).replace('.', '')}, ${publicado.toLocaleTimeString('es-ES', { ...madrid, hour: '2-digit', minute: '2-digit' })}`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <link rel="canonical" href={url} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="tuvotocuenta" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={imagenUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <ClientRouter />
    <script is:inline>
      // Claro por defecto; el oscuro solo si la persona lo eligió. Se aplica antes de pintar para evitar parpadeos
      function aplicarTema(doc) {
        try {
          if (localStorage.getItem('tema') === 'oscuro') doc.documentElement.dataset.tema = 'oscuro';
        } catch {}
      }
      aplicarTema(document);
      document.addEventListener('astro:before-swap', (e) => aplicarTema(e.newDocument));
    </script>
  </head>
  <body>
    <header class="cabecera">
      <div class="barra-superior">
        <a href="/" class="marca" aria-label="tuvotocuenta, inicio">tu<em>voto</em>cuenta</a>
        <p class="actualizada">Actualizado <time datetime={publicado.toISOString()}>{actualizado}</time></p>
        <button type="button" class="tema" data-tema-boton aria-label="Cambiar entre modo claro y oscuro">
          <span class="tema-icono" aria-hidden="true"></span>
        </button>
      </div>
      <nav aria-label="Secciones">
        <span class="subrayado" data-subrayado aria-hidden="true"></span>
        {nav.map((n) => (
          <a href={n.href} aria-current={actual.startsWith(n.href) ? 'page' : undefined}>{n.texto}</a>
        ))}
      </nav>
    </header>
    <main transition:animate="fade">
      <slot />
    </main>
    <footer class="pie">
      <p>Proyecto independiente y sin afiliación política. Datos del Ministerio del Interior, el Congreso y el BOE.</p>
      <p><a href="/sobre">Sobre el proyecto</a> · <a href="/sobre#errores">Avisar de un error</a> · <a href="/privacidad">Privacidad</a></p>
    </footer>
  </body>
</html>

<script>
  function iniciarTema() {
    document.querySelector('[data-tema-boton]')?.addEventListener('click', () => {
      const raiz = document.documentElement;
      const oscuro = raiz.dataset.tema !== 'oscuro';
      if (oscuro) raiz.dataset.tema = 'oscuro';
      else delete raiz.dataset.tema;
      try {
        localStorage.setItem('tema', oscuro ? 'oscuro' : 'claro');
      } catch {}
    });
  }
  document.addEventListener('astro:page-load', iniciarTema);

  function iniciarSubrayado() {
    const nav = document.querySelector<HTMLElement>('.cabecera nav');
    const linea = nav?.querySelector<HTMLElement>('[data-subrayado]');
    if (!nav || !linea) return;
    const enlaces = [...nav.querySelectorAll<HTMLAnchorElement>('a')];
    const mover = (a: HTMLAnchorElement | undefined, animar = true) => {
      linea.classList.toggle('sin-transicion', !animar);
      if (!a) return (linea.style.opacity = '0');
      linea.style.width = `${a.offsetWidth}px`;
      linea.style.transform = `translateX(${a.offsetLeft}px)`;
      linea.style.opacity = '1';
    };
    const actual = () => enlaces.find((a) => a.getAttribute('aria-current') === 'page');
    nav.classList.add('con-indicador');
    mover(actual(), false);
    enlaces.forEach((a) =>
      a.addEventListener('mouseenter', () => {
        nav.classList.add('senalando');
        mover(a);
      }),
    );
    nav.addEventListener('mouseleave', () => {
      nav.classList.remove('senalando');
      mover(actual());
    });
    // Con las transiciones entre páginas, el listener de la página anterior se retira antes de añadir el nuevo
    controlResize?.abort();
    controlResize = new AbortController();
    window.addEventListener('resize', () => mover(actual(), false), { signal: controlResize.signal });
  }
  let controlResize: AbortController | undefined;
  document.addEventListener('astro:page-load', iniciarSubrayado);

  // Gráficos que se animan al entrar en pantalla: escaños (aparecen uno a uno) y barras del resultado (crecen).
  // Sin JavaScript o con movimiento reducido se ven directamente, sin animación
  let observadorGraficos: IntersectionObserver | undefined;
  function iniciarAnimaciones() {
    observadorGraficos?.disconnect();
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const graficos = [...document.querySelectorAll<HTMLElement>('.escanos:not([data-escanos]), .barra')];
    observadorGraficos = new IntersectionObserver(
      (entradas) => {
        for (const e of entradas) {
          if (!e.isIntersecting) continue;
          e.target.classList.add('en-vista');
          observadorGraficos!.unobserve(e.target);
        }
      },
      { rootMargin: '0px 0px -10% 0px' },
    );
    graficos.forEach((g) => {
      [...g.children].forEach((h, i) => (h as HTMLElement).style.setProperty('--i', String(i)));
      g.dataset.animar = '';
      observadorGraficos!.observe(g);
    });
  }
  document.addEventListener('astro:page-load', iniciarAnimaciones);
</script>

<style is:global>
  :root {
    --papel: #f7f6f2;
    --tinta: #161615;
    --suave: #63625d;
    --linea: #e2e0d8;
    --resalte: #ecebe4;
    --serif: 'Instrument Serif', Georgia, serif;
    --sans: 'Instrument Sans Variable', system-ui, sans-serif;
    --ancho: 760px;
    /* Texto bajo el título de cada página: contenido en el móvil, algo mayor en pantallas anchas */
    --entradilla: 16px;
    color-scheme: light;
  }
  :root[data-tema='oscuro'] {
    --papel: #131312;
    --tinta: #ecebe5;
    --suave: #9b9a93;
    --linea: #2a2a27;
    --resalte: #1f1f1d;
    color-scheme: dark;
  }
  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
  /* Mobile first: base para móvil, min-width para pantallas grandes */
  body {
    margin: 0;
    background: var(--papel);
    color: var(--tinta);
    font-family: var(--sans);
    font-size: 16px;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
  }
  .cabecera, main, .pie {
    max-width: var(--ancho);
    margin: 0 auto;
    padding-inline: 20px;
  }
  .cabecera { display: flex; flex-direction: column; gap: 12px; padding-block: 14px 8px; }
  .barra-superior { display: flex; align-items: center; gap: 12px; }
  .marca {
    font-family: var(--serif);
    font-size: 24px;
    color: var(--tinta);
    text-decoration: none;
    letter-spacing: -0.01em;
  }
  .actualizada { margin: 0 0 0 auto; font-size: 12px; line-height: 1.2; color: var(--suave); text-align: right; }
  /* Menú: selector de secciones con borde, la actual rellena; en el móvil ocupa todo el ancho a partes iguales */
  .cabecera nav {
    position: relative;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    padding: 4px;
    border: 1px solid var(--linea);
    border-radius: 999px;
    font-size: 15px;
  }
  .cabecera nav a {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    padding: 0 14px;
    border-radius: 999px;
    color: var(--tinta);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.25s ease;
  }
  .cabecera nav a[aria-current='page'] { color: var(--papel); font-weight: 500; }
  /* Sin JavaScript, la sección actual se rellena directamente */
  .cabecera nav:not(.con-indicador) a[aria-current='page'] { background: var(--tinta); }
  /* Con JavaScript, un único relleno se desliza a la sección señalada y vuelve a la actual */
  .subrayado {
    position: absolute;
    left: 0;
    top: 4px;
    bottom: 4px;
    width: 0;
    border-radius: 999px;
    background: var(--tinta);
    opacity: 0;
    pointer-events: none;
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1), width 0.4s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.2s ease;
  }
  .subrayado.sin-transicion { transition: none; }
  .cabecera nav.senalando a { color: var(--tinta); }
  .cabecera nav.senalando a:hover { color: var(--papel); }
  .cabecera nav a:not([aria-current='page']):active { background: var(--resalte); }
  .tema { flex: none; display: grid; place-items: center; width: 40px; height: 40px; margin-right: -10px; background: none; border: 0; padding: 0; cursor: pointer; color: var(--tinta); }
  .tema-icono {
    display: block;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 1.5px solid currentColor;
    background: linear-gradient(90deg, currentColor 50%, transparent 50%);
    transition: transform 0.3s ease;
  }
  [data-tema='oscuro'] .tema-icono { transform: rotate(180deg); }
  body { transition: background-color 0.25s ease, color 0.25s ease; }
  main { padding-bottom: 48px; }
  .pie {
    border-top: 1px solid var(--linea);
    padding-block: 24px 40px;
    color: var(--suave);
    font-size: 14px;
    text-align: center;
  }
  h1, h2 { font-family: var(--serif); font-weight: 400; letter-spacing: -0.015em; }
  h1 { font-size: clamp(44px, 12vw, 76px); line-height: 1; margin: 20px 0 14px; }
  h2 { font-size: 28px; line-height: 1.1; margin: 44px 0 10px; }
  a { color: inherit; text-underline-offset: 3px; text-decoration-thickness: 1px; }
  .suave { color: var(--suave); }
  .cifra { font-variant-numeric: tabular-nums; }
  :focus-visible { outline: 2px solid var(--tinta); outline-offset: 3px; border-radius: 2px; }
  @media (min-width: 640px) {
    :root { --entradilla: 18px; }
    body { font-size: 17px; }
    .cabecera { flex-direction: row; align-items: center; gap: 20px; padding-block: 20px; }
    .barra-superior { flex: 1; }
    h1 { margin-top: 32px; }
    h2 { font-size: 32px; margin-top: 56px; }
    main { padding-bottom: 64px; }
  }
  .escanos[data-animar]:not(.en-vista) > span { opacity: 0; }
  .escanos.en-vista > span { animation: escano-entra 0.45s cubic-bezier(0.2, 0.8, 0.2, 1) both; animation-delay: calc(min(var(--i, 0), 40) * 14ms); }
  @keyframes escano-entra { from { opacity: 0; transform: scale(0.4); } }
  .barra[data-animar]:not(.en-vista) { clip-path: inset(0 100% 0 0); }
  .barra.en-vista { animation: barra-entra 0.8s cubic-bezier(0.22, 1, 0.36, 1) both; }
  @keyframes barra-entra { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0 0 0 0); } }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    * { transition: none !important; animation: none !important; }
  }
</style>
