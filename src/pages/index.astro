---
import Base from '../layouts/Base.astro';
import Fuente from '../components/Fuente.astro';

const secciones = [
  { href: '/tu-voto', titulo: 'Tu voto en tu provincia', texto: 'Cuántos diputados elige y cómo se convierten los votos en escaños.' },
  { href: '/votaciones', titulo: 'Lo que votaron', texto: 'Las votaciones clave de la última legislatura y qué votó cada grupo.' },
  { href: '/propuestas', titulo: 'Lo que proponen', texto: 'Qué dice cada programa, tema a tema y con la página exacta.', pronto: true },
];
---

<Base title="tuvotocuenta · Elecciones generales del 29 de noviembre">
  <p class="fecha suave">Elecciones generales · domingo 29 de noviembre de 2026</p>
  <Fuente de="convocatoria2026" />
  <h1>Decide con datos,<br /><em>no con ruido.</em></h1>
  <p class="entradilla">Qué proponen los partidos, qué votaron y cuánto pesa tu voto donde vives. Sin opiniones: todo con su fuente.</p>

  <ol class="secciones">
    {secciones.map((s, i) => (
      <li>
        <a href={s.pronto ? undefined : s.href} class:list={{ pronto: s.pronto }}>
          <span class="num cifra">0{i + 1}</span>
          <span class="texto">
            <span class="titulo">{s.titulo}</span>
            <span class="suave">{s.pronto ? 'Próximamente. ' : ''}{s.texto}</span>
          </span>
          {!s.pronto && <span class="flecha" aria-hidden="true">→</span>}
        </a>
      </li>
    ))}
  </ol>
</Base>

<style>
  .fecha { font-size: 14px; margin: 32px 0 0; }
  h1 em { font-style: italic; }
  .entradilla { font-size: 19px; max-width: 34ch; margin: 0 0 44px; }
  .secciones { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--linea); }
  .secciones li { border-bottom: 1px solid var(--linea); }
  .secciones a {
    display: grid;
    grid-template-columns: 48px 1fr auto;
    gap: 16px;
    align-items: baseline;
    padding: 22px 0;
    text-decoration: none;
  }
  .num { color: var(--suave); font-size: 14px; }
  .texto { display: flex; flex-direction: column; gap: 2px; }
  .titulo { font-family: var(--serif); font-size: 28px; line-height: 1.15; }
  .flecha { font-size: 22px; transition: transform 0.2s ease; }
  a:not(.pronto):hover .flecha { transform: translateX(4px); }
  .pronto { cursor: default; }
  .pronto .titulo { color: var(--suave); }
</style>
