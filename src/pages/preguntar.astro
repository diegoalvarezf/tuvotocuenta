---
import Base from '../layouts/Base.astro';
import Chat from '../components/Chat.astro';
import { CHAT_ACTIVO } from '../lib/chat';
---

<Base title="Pregunta a los programas · tuvotocuenta" description="Pregunta qué propone cada formación para el 29 de noviembre. Las respuestas salen solo de sus programas, con la cita literal y su página." sinIndexar={!CHAT_ACTIVO}>
  <h1>Pregunta a los<br /><em>programas</em></h1>
  <p class="entradilla">Escribe tu duda y te respondemos solo con lo que dicen los programas, con la cita y su página.</p>
  <Chat />
</Base>

<style>
  h1 em { font-style: italic; }
  .entradilla { font-size: var(--entradilla); max-width: 38ch; margin: 0; }
</style>
