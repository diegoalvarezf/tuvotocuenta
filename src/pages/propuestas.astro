---
import Base from '../layouts/Base.astro';
import Fuente from '../components/Fuente.astro';
import programas from '../data/programas.json';
import propuestasJson from '../data/propuestas.json';
import TEMAS from '../data/temas.json';
import candidaturas from '../data/candidaturas-2026.json';
import { color } from '../lib/partidos';
import { CHAT_ACTIVO } from '../lib/chat';
import { provincias } from '../lib/provincias';

interface Programa {
  url: string;
  fecha: string;
  titulo: string;
  paginas?: number;
  // Programa publicado solo como página web: se cita sin página y se enlaza su copia en archive.org
  web?: boolean;
  archivo?: string;
}
interface Documento {
  titulo: string;
  url: string;
  fecha?: string;
  paginas?: number;
}
interface Propuesta {
  partido: string;
  tema: string;
  resumen: string;
  cita: string;
  pagina: number;
  concreta: boolean;
  revisada: boolean;
  tabla?: boolean;
  trozos?: boolean;
  documento?: string;
}

// Solo se publican las propuestas revisadas por una persona. En local se ven también los borradores, para revisarlos.
const propuestas = (propuestasJson as Propuesta[]).filter((p) => p.revisada || import.meta.env.DEV);
const n = (x: number) => x.toLocaleString('es-ES', { useGrouping: 'always' } as Intl.NumberFormatOptions);
const partidos = programas.map((p) => ({ ...p, programa: p.programa as Programa | null, documentos: p.documentos as Documento[] }));
const publicados = partidos.filter((p) => p.programa);
const temas = TEMAS.filter((t) => propuestas.some((p) => p.tema === t));
// Propuestas visibles al cargar: las 3 primeras de cada formación en el primer tema (lo mismo que muestra el script al iniciar)
const VISIBLES_INICIO = 3;
const inicial = (p: Propuesta, lista: Propuesta[]) =>
  p.tema === temas[0] && lista.filter((x) => x.tema === temas[0]).indexOf(p) < VISIBLES_INICIO;
// Formaciones con propuestas, en el orden de la lista (de más a menos circunscripciones)
const conPropuestas = partidos.filter((p) => propuestas.some((x) => x.partido === p.siglas));
// Dónde se presenta cada formación, para el filtro de provincia
const dondeSePresenta = (corto: string) =>
  candidaturas.provincias.filter((x) => x.candidaturas.some((c) => c.formacion === corto)).map((x) => x.id);
const totales: Record<string, number> = { todas: partidos.length };
for (const x of candidaturas.provincias) totales[x.id] = new Set(x.candidaturas.map((c) => c.formacion)).size;
const provinciasOrden = [...provincias].sort((a, b) => a.nombre.localeCompare(b.nombre, 'es'));
// Documento del que salen las propuestas: su programa o, si no lo llama así, su documento principal
const fuenteDe = (siglas: string) => {
  const p = partidos.find((x) => x.siglas === siglas);
  return p?.programa ?? p?.documentos[0];
};
// Enlace a la cita: la página del PDF o, si el programa es una página web, su copia guardada con el texto resaltado
const enlaceCita = (p: Propuesta) => {
  const f = fuenteDe(p.partido) as Programa;
  if (f?.web) return `${f.archivo}#:~:text=${encodeURIComponent(p.cita.split(' · ')[0].split(/\s+/).slice(0, 8).join(' '))}`;
  return `${p.documento ?? f!.url}#page=${p.pagina}`;
};
const esWeb = (siglas: string) => Boolean((fuenteDe(siglas) as Programa)?.web);
---

<Base title="Programas electorales 2026 comparados por temas · tuvotocuenta" description="Qué propone cada partido para el 29 de noviembre, tema a tema, con la cita literal y la página exacta de su programa.">
  <h1>Lo que<br /><em>proponen</em></h1>
  <p class="entradilla">Qué dice cada programa, tema a tema, con la cita literal y su página.</p>
  {CHAT_ACTIVO && <p class="a-preguntar"><a href="/preguntar">¿Tienes una duda concreta? Pregunta a los programas <span aria-hidden="true">→</span></a></p>}
  {propuestas.length > 0 && (
    <>
      <dl class="cifras-cabecera">
        <div><dt class="cifra">{n(propuestas.length)}</dt><dd>propuestas</dd></div>
        <div><dt class="cifra">{conPropuestas.length}<span class="suave"> de </span>{partidos.length}</dt><dd>formaciones con programa revisado</dd></div>
        <div><dt class="cifra">{Math.round((propuestas.filter((p) => p.concreta).length / propuestas.length) * 100)} %</dt><dd>son concretas: con cifra, plazo o medida identificable</dd></div>
      </dl>
      <span class="fuente-propia suave">Cálculo propio con los programas oficiales de cada formación.</span>
    </>
  )}

  {propuestas.length === 0 ? (
    <section class="espera">
      <p class="estado">
        <strong>{publicados.length} de {partidos.length}</strong> formaciones han publicado su programa completo para el 29 de noviembre.
      </p>
      <p class="suave">La comparación tema a tema aún no está abierta. Mientras tanto, puedes ver <a href="/votaciones">lo que votaron</a> en la última legislatura.</p>
    </section>
  ) : (
    <>
      <div class="filtros">
        <nav class="temas" aria-label="Elegir tema" data-filtro-propuestas>
          {temas.map((t, i) => <button type="button" aria-pressed={String(i === 0)} data-tema={t}>{t}</button>)}
        </nav>
        <nav class="partidos" aria-label="Elegir formaciones" data-partidos>
          <button type="button" aria-pressed="true" data-todas>Todas</button>
          {conPropuestas.map((x) => (
            <button type="button" aria-pressed="false" data-elegir={x.siglas}><span class="punto" style={`--c:${color(x.siglas)}`}></span>{x.corto}</button>
          ))}
        </nav>
        <div class="otros-filtros">
          <label class="elegir-provincia">
            <span>Se puede votar en</span>
            <span class="desplegable">
              <select data-provincia>
                <option value="">toda España</option>
                {provinciasOrden.map((x) => <option value={x.id}>{x.nombre}</option>)}
              </select>
            </span>
          </label>
          <label class="solo-concretas"><input type="checkbox" data-concretas /> Solo concretas</label>
        </div>
      </div>
      <p class="sin-programa suave" data-sin-programa data-formaciones={JSON.stringify(totales)}></p>
      <div class="paginador" data-paginador>
        <p class="cuenta" aria-live="polite"><span class="punto" data-cuenta-punto></span><strong data-cuenta-nombre></strong> <span class="suave cifra" data-cuenta></span></p>
        <div class="flechas">
          <button type="button" class="flecha izq" data-mover="-1" aria-label="Formación anterior"></button>
          <button type="button" class="flecha der" data-mover="1" aria-label="Formación siguiente"></button>
        </div>
      </div>
      <div class="comparador" aria-label="Propuestas por formación" data-comparador>
        {conPropuestas.map((partido) => (
          <section class="columna" data-partido={partido.siglas} data-nombre={partido.corto} data-color={color(partido.siglas)} data-provincias={dondeSePresenta(partido.corto).join(' ')}>
            <header>
              <h2><span class="punto" style={`--c:${color(partido.siglas)}`}></span>{partido.nombre}</h2>
              {partido.aviso && <p class="aviso suave">{partido.aviso.texto} <a href={`${fuenteDe(partido.siglas)!.url}#page=${partido.aviso.pagina}`} target="_blank" rel="noopener">Página {partido.aviso.pagina}</a>.</p>}
            </header>
            <ul>
              {propuestas
                .filter((p) => p.partido === partido.siglas)
                .sort((a, b) => a.pagina - b.pagina)
                .filter((p, _, lista) => inicial(p, lista))
                .map((p, i) => (
                  // Solo las que se ven al entrar; el resto llega de /datos/propuestas.json al cambiar de tema
                  <li class:list={{ alterna: i % 2 === 1 }}>
                    <p class="resumen">{p.resumen}{!p.revisada && <span class="borrador"> · Sin revisar</span>}</p>
                    <span class:list={['tipo', { concreta: p.concreta }]}>{p.concreta ? 'Concreta' : 'Genérica'}</span>
                    <details>
                      <summary>{p.tabla ? 'Tabla' : 'Cita'} · {esWeb(p.partido) ? 'su web' : `pág. ${p.pagina}`}</summary>
                      {p.tabla ? <blockquote>Fila de su tabla de compromisos: {p.cita}</blockquote> : <blockquote>«{p.trozos ? p.cita.split(' · ').join('» … «') : p.cita}»</blockquote>}
                      <a class="ir-pagina" href={enlaceCita(p)} target="_blank" rel="noopener">{esWeb(p.partido) ? 'Ver en su web (copia guardada)' : `Ver la página ${p.pagina} del documento`}</a>
                    </details>
                  </li>
                ))}
            </ul>
            <p class="vacio suave" hidden={propuestas.some((p) => p.partido === partido.siglas && p.tema === temas[0])}>No dice nada sobre este tema en su documento.</p>
            {(() => {
              const mas = propuestas.filter((p) => p.partido === partido.siglas && p.tema === temas[0]).length - VISIBLES_INICIO;
              return <button type="button" class="ver-mas" data-ver-mas hidden={mas <= 0}>Ver {mas} más</button>;
            })()}
          </section>
        ))}
      </div>
      <p class="ninguna suave" data-ninguna hidden>Ninguna de las formaciones elegidas se presenta en esa provincia.</p>
    </>
  )}

  <h2>Programas</h2>
  <ul class="programas">
    {partidos.map((p) => (
      <li>
        <span><span class="punto" style={`--c:${color(p.siglas)}`}></span><span>{p.nombre} <span class="suave donde">{p.circunscripciones} de 52</span></span></span>
        <span class="suave">
          {p.programa ? (
            p.programa.web ? (
              <><a href={p.programa.url} target="_blank" rel="noopener">Programa (página web)</a> · <a href={p.programa.archivo} target="_blank" rel="noopener">copia guardada</a></>
            ) : (
              <a href={p.programa.url} target="_blank" rel="noopener">Programa ({p.programa.paginas} {p.programa.paginas === 1 ? 'pág.' : 'págs.'})</a>
            )
          ) : 'Pendiente'}
          {p.web && <> · <a href={p.web} target="_blank" rel="noopener">web oficial</a></>}
          {p.documentos.map((d) => (
            <> · <a href={d.url} target="_blank" rel="noopener">{d.titulo}</a>{d.paginas && ` (${d.paginas} págs.)`}</>
          ))}
        </span>
      </li>
    ))}
  </ul>
  <p class="suave nota">
    Las formaciones con candidaturas proclamadas al Congreso y en cuántas de las 52 circunscripciones se presentan. Se agrupan las variantes
    territoriales de una misma formación. Aún pueden cambiar por los recursos previstos en la ley. Contamos como programa el documento que la formación
    ofrece como su programa para estas elecciones, sea cual sea su extensión. Si solo lo publica como página web, lo enlazamos junto a una copia guardada en archive.org. Folletos y documentos de otras elecciones se enlazan junto a su nombre, sin contarlos. «Pendiente» significa que no lo hemos
    localizado en su web. Si falta algo, avísanos.
  </p>
  <Fuente de={['candidaturas2026', 'candidaturas2026correccion', 'loreg']} calculo detalle="art. 49 de la ley electoral" />

  <section class="metodo">
    <h2>Cómo lo hacemos</h2>
    <ol>
      <li><strong>Solo el programa oficial.</strong> Usamos el programa que publica cada partido, en PDF o en su web, nada más: ni entrevistas ni declaraciones.</li>
      <li><strong>Cita literal y página.</strong> Cada propuesta lleva el fragmento exacto del programa y un enlace a su página (o a la copia guardada de su web), para que lo compruebes tú.</li>
      <li><strong>Verificación automática.</strong> Una IA ayuda a localizar y clasificar las propuestas. Después, un programa comprueba que cada cita aparece palabra por palabra en esa página del PDF; si no aparece, se descarta. Si la propuesta es una fila de una tabla del programa, se cita la fila (qué, meta y plazo) y se comprueba cada celda.</li>
      <li><strong>Revisión.</strong> Una segunda pasada con IA comprueba cada propuesta contra su página. Después, una persona revisa una muestra de cada formación antes de publicar.</li>
      <li><strong>Concreta o genérica.</strong> Es concreta si se puede comprobar su cumplimiento: tiene una cifra, una fecha, un plazo o una medida legal o administrativa identificable, como crear o suprimir un impuesto o una ley, o una deducción bien definida aunque no lleve cifra. «Impulsaremos» o «apostaremos por» sin nada más, o un plan sin nombre ni cifra, es genérica. No mide si la propuesta es buena o mala, y el límite a veces es discutible.</li>
      <li><strong>Mismo trato para todos.</strong> Todos los programas se procesan con las mismas instrucciones y los mismos temas.</li>
    </ol>
  </section>
</Base>

<script>
  const VISIBLES = 3;
  // [partido, tema, resumen, cita, página, concreta, tabla, revisada]
  type Fila = [string, string, string, string, number, 0 | 1, 0 | 1 | 2, 0 | 1, string?];
  interface Datos {
    documentos: Record<string, string>;
    // Formaciones cuyo programa es una página web: su documento es la copia de archive.org y no hay página
    web: string[];
    propuestas: Fila[];
  }
  // Cada tema se pide una vez, cuando se elige (el primero ya viene en la página)
  const slugTema = (t: string) => t.toLowerCase().normalize('NFD').replace(/\p{M}/gu, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
  const datos = new Map<string, Promise<Datos>>();
  const cargar = (tema: string) => {
    if (!datos.has(tema)) datos.set(tema, fetch(`/datos/propuestas/${slugTema(tema)}.json`).then((r) => r.json() as Promise<Datos>));
    return datos.get(tema)!;
  };

  // Una propuesta tal como se ve en su tarjeta
  function propuesta(f: Fila, documento: string, alterna: boolean, web = false) {
    const [, , resumen, cita, pagina, concreta, tabla, revisada, parte] = f;
    const li = document.createElement('li');
    if (alterna) li.className = 'alterna';
    const p = li.appendChild(document.createElement('p'));
    p.className = 'resumen';
    p.textContent = resumen;
    if (!revisada) p.append(Object.assign(document.createElement('span'), { className: 'borrador', textContent: ' · Sin revisar' }));
    li.append(Object.assign(document.createElement('span'), { className: concreta ? 'tipo concreta' : 'tipo', textContent: concreta ? 'Concreta' : 'Genérica' }));
    const det = li.appendChild(document.createElement('details'));
    det.append(Object.assign(document.createElement('summary'), { textContent: `${tabla === 1 ? 'Tabla' : 'Cita'} · ${web ? 'su web' : `pág. ${pagina}`}` }));
    det.append(Object.assign(document.createElement('blockquote'), { textContent: tabla === 1 ? `Fila de su tabla de compromisos: ${cita}` : `«${tabla === 2 ? cita.split(' · ').join('» … «') : cita}»` }));
    det.append(Object.assign(document.createElement('a'), { className: 'ir-pagina', href: web ? `${documento}#:~:text=${encodeURIComponent(cita.split(' · ')[0].split(/\s+/).slice(0, 8).join(' '))}` : `${parte ?? documento}#page=${pagina}`, target: '_blank', rel: 'noopener', textContent: web ? 'Ver en su web (copia guardada)' : `Ver la página ${pagina} del documento` }));
    return li;
  }

  function iniciar() {
    const nav = document.querySelector<HTMLElement>('[data-filtro-propuestas]');
    if (!nav || nav.dataset.iniciado) return;
    nav.dataset.iniciado = '1';
    const botones = [...nav.querySelectorAll<HTMLButtonElement>('button')];
    const selector = document.querySelector<HTMLSelectElement>('[data-provincia]')!;
    const concretas = document.querySelector<HTMLInputElement>('[data-concretas]')!;
    const columnas = [...document.querySelectorAll<HTMLElement>('.columna')];
    const nota = document.querySelector<HTMLElement>('[data-sin-programa]')!;
    const totales = JSON.parse(nota.dataset.formaciones!) as Record<string, number>;
    const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-elegir]')];
    const chipTodas = document.querySelector<HTMLButtonElement>('[data-todas]')!;
    const ninguna = document.querySelector<HTMLElement>('[data-ninguna]')!;
    // Formaciones en las que se han abierto todas las propuestas del tema
    const abiertas = new Set<string>();

    // Tarjetas: en el móvil una por pantalla, se pasa de una a otra deslizando o con las flechas
    const comparador = document.querySelector<HTMLElement>('[data-comparador]')!;
    const cuenta = document.querySelector<HTMLElement>('[data-cuenta]')!;
    const cuentaNombre = document.querySelector<HTMLElement>('[data-cuenta-nombre]')!;
    const cuentaPunto = document.querySelector<HTMLElement>('[data-cuenta-punto]')!;
    const flechas = [...document.querySelectorAll<HTMLButtonElement>('[data-mover]')];
    const visiblesCol = () => columnas.filter((c) => !c.hidden);
    const inicio = () => parseFloat(getComputedStyle(comparador).paddingLeft) || 0;
    const actualCol = () => {
      const v = visiblesCol();
      let mejor = 0;
      v.forEach((c, i) => {
        if (Math.abs(c.offsetLeft - inicio() - comparador.scrollLeft) < Math.abs(v[mejor].offsetLeft - inicio() - comparador.scrollLeft)) mejor = i;
      });
      return mejor;
    };
    const marcarCol = () => {
      const v = visiblesCol();
      const i = actualCol();
      const c = v[i];
      cuentaNombre.textContent = c?.dataset.nombre ?? '';
      cuentaPunto.style.setProperty('--c', c?.dataset.color ?? 'transparent');
      cuenta.textContent = v.length > 1 ? `${i + 1} de ${v.length}` : '';
      flechas[0].disabled = i === 0;
      // Al final del desplazamiento (pantallas anchas con varias tarjetas a la vista) tampoco se puede avanzar
      flechas[1].disabled = i >= v.length - 1 || comparador.scrollLeft + comparador.clientWidth >= comparador.scrollWidth - 2;
    };
    const irCol = (i: number) => {
      const v = visiblesCol();
      const destino = v[Math.max(0, Math.min(v.length - 1, i))];
      if (destino) comparador.scrollTo({ left: destino.offsetLeft - inicio(), behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    };
    flechas.forEach((b) => b.addEventListener('click', () => irCol(actualCol() + Number(b.dataset.mover))));
    comparador.addEventListener('scrollend', marcarCol);
    let espera: ReturnType<typeof setTimeout>;
    comparador.addEventListener('scroll', () => {
      clearTimeout(espera);
      espera = setTimeout(marcarCol, 60);
    }, { passive: true });

    // Qué formaciones se ven (según provincia y formaciones elegidas): no necesita los datos
    const pintarColumnas = () => {
      const provincia = selector.value;
      const elegidos = chips.filter((c) => c.getAttribute('aria-pressed') === 'true').map((c) => c.dataset.elegir);
      let conPrograma = 0;
      let visibles = 0;
      columnas.forEach((col) => {
        const sePresenta = !provincia || col.dataset.provincias!.split(' ').includes(provincia);
        if (sePresenta) conPrograma++;
        col.hidden = !sePresenta || (elegidos.length > 0 && !elegidos.includes(col.dataset.partido));
        if (!col.hidden) visibles++;
      });
      ninguna.hidden = visibles > 0;
      nota.textContent = `Formaciones con un documento extenso ya revisado: ${conPrograma} de ${totales[provincia || 'todas']}. Las demás se añadirán cuando lo publiquen.`;
      marcarCol();
    };
    // Propuestas del tema elegido en cada tarjeta
    let turno = 0;
    const pintarListas = async () => {
      const mio = ++turno;
      const tema = botones.find((b) => b.getAttribute('aria-pressed') === 'true')!.dataset.tema!;
      const d = await cargar(tema);
      // Si mientras llegaban los datos se eligió otra cosa, solo vale la última petición
      if (mio !== turno) return;
      columnas.forEach((col) => {
        const siglas = col.dataset.partido!;
        const delTema = d.propuestas.filter((f) => f[0] === siglas && f[1] === tema && (!concretas.checked || f[5] === 1));
        const limite = abiertas.has(siglas) ? delTema.length : VISIBLES;
        col.querySelector('ul')!.replaceChildren(...delTema.slice(0, limite).map((f, i) => propuesta(f, d.documentos[siglas], i % 2 === 1, d.web.includes(siglas))));
        const verMas = col.querySelector<HTMLButtonElement>('[data-ver-mas]')!;
        verMas.hidden = delTema.length <= limite;
        verMas.textContent = `Ver ${delTema.length - limite} más`;
        const vacio = col.querySelector<HTMLElement>('.vacio')!;
        vacio.hidden = delTema.length > 0;
        vacio.textContent = concretas.checked ? 'Sin propuestas concretas sobre este tema.' : 'No dice nada sobre este tema en su documento.';
      });
      marcarCol();
    };
    const pintar = () => {
      pintarColumnas();
      pintarListas();
    };
    const cambiar = () => {
      abiertas.clear();
      comparador.scrollTo({ left: 0 });
      pintar();
    };
    botones.forEach((b) =>
      b.addEventListener('click', () => {
        botones.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        cambiar();
      }),
    );
    chips.forEach((c) =>
      c.addEventListener('click', () => {
        c.setAttribute('aria-pressed', String(c.getAttribute('aria-pressed') !== 'true'));
        chipTodas.setAttribute('aria-pressed', String(!chips.some((x) => x.getAttribute('aria-pressed') === 'true')));
        cambiar();
      }),
    );
    chipTodas.addEventListener('click', () => {
      chips.forEach((x) => x.setAttribute('aria-pressed', 'false'));
      chipTodas.setAttribute('aria-pressed', 'true');
      cambiar();
    });
    selector.addEventListener('change', cambiar);
    concretas.addEventListener('change', cambiar);
    columnas.forEach((col) =>
      col.querySelector('[data-ver-mas]')!.addEventListener('click', () => {
        abiertas.add(col.dataset.partido!);
        pintar();
      }),
    );
    pintarColumnas();
  }
  document.addEventListener('astro:page-load', iniciar);
  iniciar();
</script>

<style>
  h1 em { font-style: italic; }
  .entradilla { font-size: var(--entradilla); max-width: 38ch; margin: 0; }
  .a-preguntar { margin: 10px 0 0; font-size: 15px; }
  .fuente-propia { display: block; margin: 6px 0 28px; font-size: 13px; line-height: 1.45; }

  .espera { border-top: 1px solid var(--tinta); padding-top: 16px; }
  .estado { font-family: var(--serif); font-size: 28px; line-height: 1.2; margin: 0 0 8px; }
  .estado strong { font-weight: 400; font-style: italic; }

  .filtros { border-top: 1px solid var(--tinta); padding-top: 16px; }
  .temas, .partidos { display: grid; grid-template-rows: auto auto; grid-auto-flow: column; grid-auto-columns: max-content; gap: 6px; overflow-x: auto; margin-inline: -20px; padding: 0 20px 4px; scrollbar-width: none; }
  .temas::-webkit-scrollbar, .partidos::-webkit-scrollbar { display: none; }
