---
import Base from '../layouts/Base.astro';
import Fuente from '../components/Fuente.astro';
import programas from '../data/programas.json';
import propuestasJson from '../data/propuestas.json';
import TEMAS from '../data/temas.json';
import candidaturas from '../data/candidaturas-2026.json';
import { color } from '../lib/partidos';
import { provincias } from '../lib/provincias';

interface Programa {
  url: string;
  fecha: string;
  titulo: string;
  paginas: number;
}
interface Documento {
  titulo: string;
  url: string;
  fecha?: string;
  paginas?: number;
}
interface Propuesta {
  partido: string;
  tema: string;
  resumen: string;
  cita: string;
  pagina: number;
  concreta: boolean;
  revisada: boolean;
  tabla?: boolean;
}

// Solo se publican las propuestas revisadas por una persona. En local se ven también los borradores, para revisarlos.
const propuestas = (propuestasJson as Propuesta[]).filter((p) => p.revisada || import.meta.env.DEV);
const partidos = programas.map((p) => ({ ...p, programa: p.programa as Programa | null, documentos: p.documentos as Documento[] }));
const publicados = partidos.filter((p) => p.programa);
const temas = TEMAS.filter((t) => propuestas.some((p) => p.tema === t));
// Formaciones con propuestas, en el orden de la lista (de más a menos circunscripciones)
const conPropuestas = partidos.filter((p) => propuestas.some((x) => x.partido === p.siglas));
// Dónde se presenta cada formación, para el filtro de provincia
const dondeSePresenta = (corto: string) =>
  candidaturas.provincias.filter((x) => x.candidaturas.some((c) => c.formacion === corto)).map((x) => x.id);
const totales: Record<string, number> = { todas: partidos.length };
for (const x of candidaturas.provincias) totales[x.id] = new Set(x.candidaturas.map((c) => c.formacion)).size;
const provinciasOrden = [...provincias].sort((a, b) => a.nombre.localeCompare(b.nombre, 'es'));
// Documento del que salen las propuestas: su programa o, si no lo llama así, su documento principal
const fuenteDe = (siglas: string) => {
  const p = partidos.find((x) => x.siglas === siglas);
  return p?.programa ?? p?.documentos[0];
};
---

<Base title="Lo que proponen · tuvotocuenta" description="Qué propone cada partido para el 29 de noviembre, tema a tema, con la cita literal y la página exacta de su programa.">
  <h1>Lo que<br /><em>proponen</em></h1>
  <p class="entradilla">Qué dice cada programa, tema a tema. Siempre con la cita literal y un enlace a la página exacta del documento.</p>

  {propuestas.length === 0 ? (
    <section class="espera">
      <p class="estado">
        <strong>{publicados.length} de {partidos.length}</strong> formaciones han publicado su programa completo para el 29 de noviembre.
      </p>
      <p class="suave">La comparación tema a tema aún no está abierta. Mientras tanto, puedes ver <a href="/votaciones">lo que votaron</a> en la última legislatura.</p>
    </section>
  ) : (
    <>
      <div class="filtros">
        <nav class="temas" aria-label="Elegir tema" data-temas>
          {temas.map((t, i) => <button type="button" aria-pressed={String(i === 0)} data-tema={t}>{t}</button>)}
        </nav>
        <nav class="partidos" aria-label="Elegir formaciones" data-partidos>
          <button type="button" aria-pressed="true" data-todas>Todas</button>
          {conPropuestas.map((x) => (
            <button type="button" aria-pressed="false" data-elegir={x.siglas}><span class="punto" style={`--c:${color(x.siglas)}`}></span>{x.corto}</button>
          ))}
        </nav>
        <div class="otros-filtros">
          <label class="elegir-provincia">
            <span>Se puede votar en</span>
            <span class="desplegable">
              <select data-provincia>
                <option value="">toda España</option>
                {provinciasOrden.map((x) => <option value={x.id}>{x.nombre}</option>)}
              </select>
            </span>
          </label>
          <label class="solo-concretas"><input type="checkbox" data-concretas /> Solo concretas</label>
        </div>
      </div>
      <p class="sin-programa suave" data-sin-programa data-formaciones={JSON.stringify(totales)}></p>
      <div class="comparador" tabindex="0" aria-label="Propuestas por formación">
        {conPropuestas.map((partido) => (
          <section class="columna" data-partido={partido.siglas} data-provincias={dondeSePresenta(partido.corto).join(' ')}>
            <header>
              <h2><span class="punto" style={`--c:${color(partido.siglas)}`}></span>{partido.nombre}</h2>
              {partido.aviso && <p class="aviso suave">{partido.aviso.texto} <a href={`${fuenteDe(partido.siglas)!.url}#page=${partido.aviso.pagina}`} target="_blank" rel="noopener">Página {partido.aviso.pagina}</a>.</p>}
            </header>
            <ul>
              {propuestas
                .filter((p) => p.partido === partido.siglas)
                .sort((a, b) => a.pagina - b.pagina)
                .map((p) => (
                  <li data-tema={p.tema} data-concreta={String(p.concreta)}>
                    <p class="resumen">{p.resumen}{!p.revisada && <span class="borrador"> · Sin revisar</span>}</p>
                    <span class="tipo" data-concreta={String(p.concreta)}>{p.concreta ? 'Concreta' : 'Genérica'}</span>
                    <details>
                      <summary>{p.tabla ? 'Tabla' : 'Cita'} · pág. {p.pagina}</summary>
                      {p.tabla ? <blockquote>Fila de su tabla de compromisos: {p.cita}</blockquote> : <blockquote>«{p.cita}»</blockquote>}
                      <a class="ir-pagina" href={`${fuenteDe(p.partido)!.url}#page=${p.pagina}`} target="_blank" rel="noopener">Ver la página {p.pagina} del documento</a>
                    </details>
                  </li>
                ))}
            </ul>
            <p class="vacio suave" hidden>No dice nada sobre este tema en su documento.</p>
          </section>
        ))}
      </div>
      <p class="ninguna suave" data-ninguna hidden>Ninguna de las formaciones elegidas se presenta en esa provincia.</p>
      <button type="button" class="ver-mas" data-ver-mas hidden></button>
    </>
  )}

  <h2>Programas</h2>
  <ul class="programas">
    {partidos.map((p) => (
      <li>
        <span><span class="punto" style={`--c:${color(p.siglas)}`}></span><span>{p.nombre} <span class="suave donde">{p.circunscripciones} de 52</span></span></span>
        <span class="suave">
          {p.programa ? <a href={p.programa.url} target="_blank" rel="noopener">Programa ({p.programa.paginas} págs.)</a> : 'Pendiente'}
          {p.web && <> · <a href={p.web} target="_blank" rel="noopener">web oficial</a></>}
          {p.documentos.map((d) => (
            <> · <a href={d.url} target="_blank" rel="noopener">{d.titulo}</a>{d.paginas && ` (${d.paginas} págs.)`}</>
          ))}
        </span>
      </li>
    ))}
  </ul>
  <p class="suave nota">
    Las formaciones con candidaturas proclamadas al Congreso y en cuántas de las 52 circunscripciones se presentan. Se agrupan las variantes
    territoriales de una misma formación. Aún pueden cambiar por los recursos previstos en la ley. Contamos como programa completo el documento de 20 páginas o más que la
    formación ofrece como su programa electoral. Los textos más breves se enlazan junto a su nombre, sin contarlos. «Pendiente» significa que no lo hemos
    localizado en su web. Si falta algo, avísanos.
  </p>
  <Fuente de={['candidaturas2026', 'candidaturas2026correccion', 'loreg']} calculo detalle="art. 49 de la ley electoral" />

  <section class="metodo">
    <h2>Cómo lo hacemos</h2>
    <ol>
      <li><strong>Solo el programa oficial.</strong> Usamos el PDF que publica cada partido en su web, nada más: ni entrevistas ni declaraciones.</li>
      <li><strong>Cita literal y página.</strong> Cada propuesta lleva el fragmento exacto del programa y un enlace a su página, para que lo compruebes tú.</li>
      <li><strong>Verificación automática.</strong> Una IA ayuda a localizar y clasificar las propuestas. Después, un programa comprueba que cada cita aparece palabra por palabra en esa página del PDF; si no aparece, se descarta. Si la propuesta es una fila de una tabla del programa, se cita la fila (qué, meta y plazo) y se comprueba cada celda.</li>
      <li><strong>Revisión.</strong> Una segunda pasada con IA comprueba cada propuesta contra su página. Después, una persona revisa una muestra de cada formación antes de publicar.</li>
      <li><strong>Concreta o genérica.</strong> Es concreta si se puede comprobar su cumplimiento: tiene una cifra, una fecha, un plazo o una medida legal o administrativa identificable, como crear o suprimir un impuesto o una ley, o una deducción bien definida aunque no lleve cifra. «Impulsaremos» o «apostaremos por» sin nada más, o un plan sin nombre ni cifra, es genérica. No mide si la propuesta es buena o mala, y el límite a veces es discutible.</li>
      <li><strong>Mismo trato para todos.</strong> Todos los programas se procesan con las mismas instrucciones y los mismos temas.</li>
    </ol>
  </section>
</Base>

<script>
  const VISIBLES = 3;
  function iniciar() {
    const nav = document.querySelector<HTMLElement>('[data-temas]');
    if (!nav) return;
    const botones = [...nav.querySelectorAll<HTMLButtonElement>('button')];
    const selector = document.querySelector<HTMLSelectElement>('[data-provincia]')!;
    const concretas = document.querySelector<HTMLInputElement>('[data-concretas]')!;
    const columnas = [...document.querySelectorAll<HTMLElement>('.columna')];
    const nota = document.querySelector<HTMLElement>('[data-sin-programa]')!;
    const verMas = document.querySelector<HTMLButtonElement>('[data-ver-mas]')!;
    const totales = JSON.parse(nota.dataset.formaciones!) as Record<string, number>;
    const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-elegir]')];
    const chipTodas = document.querySelector<HTMLButtonElement>('[data-todas]')!;
    const ninguna = document.querySelector<HTMLElement>('[data-ninguna]')!;
    let todas = false;

    const pintar = () => {
      const tema = botones.find((b) => b.getAttribute('aria-pressed') === 'true')!.dataset.tema;
      const provincia = selector.value;
      const elegidos = chips.filter((c) => c.getAttribute('aria-pressed') === 'true').map((c) => c.dataset.elegir);
      let conPrograma = 0;
      let ocultas = 0;
      let visibles = 0;
      columnas.forEach((col) => {
        const sePresenta = !provincia || col.dataset.provincias!.split(' ').includes(provincia);
        if (sePresenta) conPrograma++;
        col.hidden = !sePresenta || (elegidos.length > 0 && !elegidos.includes(col.dataset.partido));
        if (!col.hidden) visibles++;
        const delTema = [...col.querySelectorAll<HTMLElement>('li[data-tema]')].filter((li) => {
          li.hidden = true;
          return li.dataset.tema === tema && (!concretas.checked || li.dataset.concreta === 'true');
        });
        const limite = todas ? delTema.length : VISIBLES;
        delTema.slice(0, limite).forEach((li, i) => {
          li.hidden = false;
          // Sombreado alterno entre las propuestas que se ven
          li.classList.toggle('alterna', i % 2 === 1);
        });
        if (!col.hidden) ocultas += Math.max(0, delTema.length - limite);
        const vacio = col.querySelector<HTMLElement>('.vacio')!;
        vacio.hidden = delTema.length > 0;
        vacio.textContent = concretas.checked ? 'Sin propuestas concretas sobre este tema.' : 'No dice nada sobre este tema en su documento.';
      });
      ninguna.hidden = visibles > 0;
      verMas.hidden = ocultas === 0;
      verMas.textContent = `Ver ${ocultas} más`;
      nota.textContent = `Formaciones con un documento extenso ya revisado: ${conPrograma} de ${totales[provincia || 'todas']}. Las demás se añadirán cuando lo publiquen.`;
    };
    const cambiar = () => {
      todas = false;
      pintar();
    };
    botones.forEach((b) =>
      b.addEventListener('click', () => {
        botones.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        cambiar();
      }),
    );
    chips.forEach((c) =>
      c.addEventListener('click', () => {
        c.setAttribute('aria-pressed', String(c.getAttribute('aria-pressed') !== 'true'));
        chipTodas.setAttribute('aria-pressed', String(!chips.some((x) => x.getAttribute('aria-pressed') === 'true')));
        cambiar();
      }),
    );
    chipTodas.addEventListener('click', () => {
      chips.forEach((x) => x.setAttribute('aria-pressed', 'false'));
      chipTodas.setAttribute('aria-pressed', 'true');
      cambiar();
    });
    selector.addEventListener('change', cambiar);
    concretas.addEventListener('change', cambiar);
    verMas.addEventListener('click', () => {
      todas = true;
      pintar();
    });
    pintar();
  }
  document.addEventListener('astro:page-load', iniciar);
</script>

<style>
  h1 em { font-style: italic; }
  .entradilla { font-size: 18px; max-width: 38ch; margin: 0 0 32px; }

  .espera { border-top: 1px solid var(--tinta); padding-top: 16px; }
  .estado { font-family: var(--serif); font-size: 28px; line-height: 1.2; margin: 0 0 8px; }
  .estado strong { font-weight: 400; font-style: italic; }

  .filtros { border-top: 1px solid var(--tinta); padding-top: 16px; }
  .temas, .partidos { display: grid; grid-template-rows: auto auto; grid-auto-flow: column; grid-auto-columns: max-content; gap: 6px; overflow-x: auto; margin-inline: -20px; padding: 0 20px 4px; scrollbar-width: none; }
  .temas::-webkit-scrollbar, .partidos::-webkit-scrollbar { display: none; }
  .partidos { grid-template-rows: auto; margin-top: 12px; padding-top: 12px; border-top: 1px solid var(--linea); }
  .partidos { margin-inline: -20px; }
  .temas button, .partidos button {
    font: inherit;
    font-size: 14px;
    line-height: 1.2;
    padding: 7px 12px;
    border-radius: 999px;
    border: 1px solid var(--linea);
    background: transparent;
    color: var(--suave);
    cursor: pointer;
    transition: background-color 0.15s, color 0.15s, border-color 0.15s;
  }
  .temas button:hover, .partidos button:hover { color: var(--tinta); border-color: var(--suave); }
  .partidos button { display: inline-flex; align-items: center; }
  .partidos .punto { width: 8px; height: 8px; margin-right: 7px; }
  .temas button[aria-pressed='true'], .partidos button[aria-pressed='true'] { background: var(--tinta); color: var(--papel); border-color: var(--tinta); }
  .otros-filtros { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px 20px; margin-top: 16px; padding-top: 12px; border-top: 1px solid var(--linea); }
  .solo-concretas { display: inline-flex; align-items: center; gap: 8px; font-size: 14px; cursor: pointer; min-height: 36px; }
  .solo-concretas input { accent-color: var(--tinta); width: 16px; height: 16px; margin: 0; }

  .elegir-provincia { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 8px; font-size: 14px; }
  .desplegable { position: relative; display: inline-flex; }
  .desplegable::after { content: ''; position: absolute; right: 14px; top: 50%; width: 7px; height: 7px; border-right: 1.5px solid var(--tinta); border-bottom: 1.5px solid var(--tinta); transform: translateY(-70%) rotate(45deg); pointer-events: none; }
  .desplegable select { appearance: none; font: inherit; color: var(--tinta); background: transparent; border: 1px solid var(--linea); border-radius: 999px; padding: 7px 34px 7px 14px; cursor: pointer; }
  .comparador {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    margin-inline: -20px;
    padding-inline: 20px;
    scroll-padding-inline: 20px;
    border-top: 1px solid var(--tinta);
  }
  .columna { flex: 0 0 min(80vw, 300px); padding: 14px 14px 8px; scroll-snap-align: start; min-width: 0; }
  .columna + .columna { border-left: 1px solid var(--linea); }
  .columna[hidden], .columna li[hidden] { display: none; }
  .columna header { padding-bottom: 10px; border-bottom: 1px solid var(--linea); }
  .columna h2 { font-size: 22px; line-height: 1.15; margin: 0; display: flex; align-items: baseline; }
  .columna ul { list-style: none; margin: 0; padding: 0; }
  .columna li { padding: 14px; margin-inline: -14px; }
  .columna li.alterna { background: var(--resalte); }
  .resumen { margin: 0 0 8px; font-size: 15px; line-height: 1.4; }
  .tipo { display: inline-block; font-size: 12px; color: var(--suave); margin-right: 8px; }
  .tipo[data-concreta='true'] { color: var(--tinta); font-weight: 600; }
  .columna details { display: inline; font-size: 12px; color: var(--suave); }
  .columna summary { display: inline; cursor: pointer; text-decoration: underline; text-underline-offset: 3px; }
  .columna summary::-webkit-details-marker { display: none; }
  .columna details[open] summary { color: var(--tinta); }
  blockquote { margin: 10px 0 8px; padding-left: 10px; border-left: 2px solid var(--linea); color: var(--suave); font-size: 14px; line-height: 1.45; }
  .ir-pagina { font-size: 12px; }
  p.ninguna { font-size: 14px; margin: 16px 0 0; }
  p.aviso { font-size: 13px; line-height: 1.4; margin: 6px 0 0; }
  p.sin-programa { font-size: 13px; line-height: 1.4; margin: 12px 0 16px; }
  .borrador { font-size: 12px; color: var(--suave); }
  .ver-mas { display: block; width: 100%; font: inherit; font-size: 14px; color: var(--tinta); background: transparent; border: 1px solid var(--linea); border-radius: 999px; padding: 10px; margin-top: 16px; cursor: pointer; }
  .ver-mas:hover { border-color: var(--suave); }
  .ver-mas[hidden] { display: none; }

  .punto { width: 10px; height: 10px; border-radius: 50%; background: var(--c); margin-right: 10px; flex: none; display: inline-block; }
  .donde { font-size: 13px; margin-left: 4px; white-space: nowrap; }
  .programas { list-style: none; margin: 0; padding: 0; }
  .programas li { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; padding: 10px 0; border-bottom: 1px solid var(--linea); }
  .programas li > span:first-child { display: flex; align-items: center; }
  .nota { font-size: 13px; margin: 12px 0 0; }

  .metodo ol { padding-left: 20px; margin: 0; }
  .metodo li { margin-bottom: 12px; }

  @media (min-width: 640px) {
    .temas, .partidos { display: flex; flex-wrap: wrap; overflow: visible; margin-inline: 0; }
    .temas { padding: 0; }
    .partidos { padding: 12px 0 0; }
    .columna { flex: 1 0 236px; }
    .comparador { margin-inline: 0; padding-inline: 0; }
  }
</style>
