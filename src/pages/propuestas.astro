---
import Base from '../layouts/Base.astro';
import Fuente from '../components/Fuente.astro';
import programas from '../data/programas.json';
import propuestasJson from '../data/propuestas.json';
import TEMAS from '../data/temas.json';
import { color } from '../lib/partidos';

interface Programa {
  url: string;
  fecha: string;
  titulo: string;
}
interface Propuesta {
  partido: string;
  tema: string;
  resumen: string;
  cita: string;
  pagina: number;
  concreta: boolean;
  revisada: boolean;
}

// Solo se publican las propuestas revisadas por una persona
const propuestas = (propuestasJson as Propuesta[]).filter((p) => p.revisada);
const partidos = programas.map((p) => ({ ...p, programa: p.programa as Programa | null }));
const publicados = partidos.filter((p) => p.programa);
const temas = TEMAS.filter((t) => propuestas.some((p) => p.tema === t));
const programaDe = (siglas: string) => partidos.find((p) => p.siglas === siglas)?.programa;
const fecha = (f: string) => new Date(f + 'T12:00:00').toLocaleDateString('es-ES', { day: 'numeric', month: 'long' });
---

<Base title="Lo que proponen · tuvotocuenta" description="Qué propone cada partido para el 29 de noviembre, tema a tema, con la cita literal y la página exacta de su programa.">
  <h1>Lo que<br /><em>proponen</em></h1>
  <p class="entradilla">Qué dice cada programa, tema a tema. Siempre con la cita literal y un enlace a la página exacta del documento.</p>

  {propuestas.length === 0 ? (
    <section class="espera">
      <p class="estado">
        <strong>{publicados.length} de {partidos.length}</strong> formaciones han publicado su programa para el 29 de noviembre.
      </p>
      <p class="suave">Esta sección se abrirá en cuanto empiecen a publicarse. Mientras tanto, puedes ver <a href="/votaciones">lo que votaron</a> en la última legislatura.</p>
    </section>
  ) : (
    <>
      <nav class="filtro" aria-label="Elegir tema" data-temas>
        {temas.map((t, i) => <button type="button" aria-pressed={String(i === 0)} data-tema={t}>{t}</button>)}
      </nav>
      <div class="comparador">
        {publicados.map((partido) => (
          <section class="columna" data-partido={partido.siglas}>
            <h2 title={partido.nombre}><span class="punto" style={`--c:${color(partido.siglas)}`}></span>{partido.corto}</h2>
            <ul>
              {propuestas
                .filter((p) => p.partido === partido.siglas)
                .map((p) => (
                  <li data-tema={p.tema}>
                    <p class="resumen">{p.resumen}</p>
                    <blockquote>«{p.cita}»</blockquote>
                    <p class="meta suave">
                      <a href={`${programaDe(p.partido)!.url}#page=${p.pagina}`} target="_blank" rel="noopener">Página {p.pagina} del programa</a>
                      {' · '}
                      <span class:list={['tipo', { concreta: p.concreta }]}>{p.concreta ? 'Concreta' : 'Genérica'}</span>
                    </p>
                  </li>
                ))}
            </ul>
            <p class="vacio suave" hidden>Sin propuestas sobre este tema en su programa.</p>
          </section>
        ))}
      </div>
    </>
  )}

  <h2>Programas</h2>
  <ul class="programas">
    {partidos.map((p) => (
      <li>
        <span><span class="punto" style={`--c:${color(p.siglas)}`}></span><span>{p.nombre} <span class="suave donde">{p.circunscripciones} de 52</span></span></span>
        {p.programa ? (
          <a href={p.programa.url} target="_blank" rel="noopener">Publicado el {fecha(p.programa.fecha)}</a>
        ) : p.web ? (
          <span class="suave">Pendiente · <a href={p.web} target="_blank" rel="noopener">web oficial</a></span>
        ) : (
          <span class="suave">Pendiente</span>
        )}
      </li>
    ))}
  </ul>
  <p class="suave nota">
    Las formaciones con candidaturas proclamadas al Congreso y en cuántas de las 52 circunscripciones se presentan. Se agrupan las variantes
    territoriales de una misma formación. Aún pueden cambiar por los recursos previstos en la ley.
  </p>
  <Fuente de={['candidaturas2026', 'loreg']} calculo detalle="art. 49 de la ley electoral" />

  <section class="metodo">
    <h2>Cómo lo hacemos</h2>
    <ol>
      <li><strong>Solo el programa oficial.</strong> Usamos el PDF que publica cada partido en su web, nada más: ni entrevistas ni declaraciones.</li>
      <li><strong>Cita literal y página.</strong> Cada propuesta lleva el fragmento exacto del programa y un enlace a su página, para que lo compruebes tú.</li>
      <li><strong>Verificación automática.</strong> Una IA ayuda a localizar y clasificar las propuestas. Después, un programa comprueba que cada cita aparece palabra por palabra en esa página del PDF; si no aparece, se descarta.</li>
      <li><strong>Revisión humana.</strong> Ninguna propuesta se publica sin que una persona la haya revisado.</li>
      <li><strong>Concreta o genérica.</strong> Marcamos como concreta la propuesta que incluye una cifra, una fecha, un plazo o una medida comprobable. «Impulsaremos» o «apostaremos por» sin nada más es genérica.</li>
      <li><strong>Mismo trato para todos.</strong> Todos los programas se procesan con las mismas instrucciones y los mismos temas.</li>
    </ol>
  </section>
</Base>

<script>
  function iniciar() {
    const nav = document.querySelector<HTMLElement>('[data-temas]');
    if (!nav) return;
    const botones = nav.querySelectorAll<HTMLButtonElement>('button');
    const aplicar = (tema: string) => {
      botones.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.tema === tema)));
      document.querySelectorAll<HTMLElement>('.columna').forEach((col) => {
        const items = col.querySelectorAll<HTMLElement>('li[data-tema]');
        let visibles = 0;
        items.forEach((li) => {
          li.hidden = li.dataset.tema !== tema;
          if (!li.hidden) visibles++;
        });
        col.querySelector<HTMLElement>('.vacio')!.hidden = visibles > 0;
      });
    };
    botones.forEach((b) => b.addEventListener('click', () => aplicar(b.dataset.tema!)));
    if (botones[0]) aplicar(botones[0].dataset.tema!);
  }
  document.addEventListener('astro:page-load', iniciar);
</script>

<style>
  h1 em { font-style: italic; }
  .entradilla { font-size: 18px; max-width: 38ch; margin: 0 0 32px; }

  .espera { border-top: 1px solid var(--tinta); padding-top: 16px; }
  .estado { font-family: var(--serif); font-size: 28px; line-height: 1.2; margin: 0 0 8px; }
  .estado strong { font-weight: 400; font-style: italic; }

  .filtro { display: flex; gap: 8px; overflow-x: auto; margin: 0 -20px 16px; padding: 0 20px 8px; scrollbar-width: none; }
  .filtro button {
    flex: none;
    font: inherit;
    font-size: 14px;
    padding: 8px 14px;
    border-radius: 999px;
    border: 1px solid var(--linea);
    background: transparent;
    color: var(--tinta);
    cursor: pointer;
  }
  .filtro button[aria-pressed='true'] { background: var(--tinta); color: var(--papel); border-color: var(--tinta); }

  .comparador { display: grid; gap: 8px; }
  .columna { border-top: 1px solid var(--tinta); padding-top: 12px; }
  .columna h2 { font-size: 24px; margin: 0 0 8px; display: flex; align-items: center; }
  .columna ul { list-style: none; margin: 0; padding: 0; }
  .columna li { padding: 12px 0; border-bottom: 1px solid var(--linea); }
  .resumen { margin: 0 0 8px; font-weight: 500; }
  blockquote { margin: 0; padding-left: 12px; border-left: 2px solid var(--linea); color: var(--suave); font-size: 15px; }
  .meta { font-size: 13px; margin: 8px 0 0; }
  .tipo.concreta { color: var(--tinta); font-weight: 600; }

  .punto { width: 10px; height: 10px; border-radius: 50%; background: var(--c); margin-right: 10px; flex: none; display: inline-block; }
  .donde { font-size: 13px; margin-left: 4px; white-space: nowrap; }
  .programas { list-style: none; margin: 0; padding: 0; }
  .programas li { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; padding: 10px 0; border-bottom: 1px solid var(--linea); }
  .programas li > span:first-child { display: flex; align-items: center; }
  .nota { font-size: 13px; margin: 12px 0 0; }

  .metodo ol { padding-left: 20px; margin: 0; }
  .metodo li { margin-bottom: 12px; }

  @media (min-width: 640px) {
    .filtro { margin-inline: 0; padding-inline: 0; flex-wrap: wrap; }
    .comparador { grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); column-gap: 32px; }
  }
</style>
