---
import candidaturas2026 from '../../data/candidaturas-2026.json';
import Base from '../../layouts/Base.astro';
import Escanos from '../../components/Escanos.astro';
import Fuente from '../../components/Fuente.astro';
import { provincias, resultados2026, ultimoEscano, type Provincia } from '../../lib/provincias';
import { color } from '../../lib/partidos';
import { UMBRAL } from '../../lib/dhondt';

export function getStaticPaths() {
  return provincias.map((p) => ({ params: { provincia: p.slug }, props: { p } }));
}

const { p } = Astro.props as { p: Provincia };
const n = (x: number) => x.toLocaleString('es-ES', { useGrouping: 'always' } as Intl.NumberFormatOptions);
const pct = (x: number) => (x * 100).toLocaleString('es-ES', { maximumFractionDigits: 1 }) + '\u202f%';

const umbral = Math.ceil(p.votosValidos * UMBRAL);
const principales = p.candidaturas.filter((c) => c.votos / p.votosValidos >= 0.01 || c.escanos > 0);
const otros = p.candidaturas.filter((c) => !principales.includes(c)).reduce((s, c) => s + c.votos, 0);
const ultimo = ultimoEscano(p);
const diferencia = p.escanos2026 - p.escanos2023;
const palabra = (x: number) => (x === 1 ? 'diputado' : 'diputados');

// Resultado del 29 de noviembre (si ya existe) y cambio de escaños frente a 2023 por siglas
const r26 = p.r2026;
const principales26 = r26 ? r26.candidaturas.filter((c) => c.votos / r26.votosValidos >= 0.01 || c.escanos > 0) : [];
const otros26 = r26 ? r26.candidaturas.filter((c) => !principales26.includes(c)).reduce((s, c) => s + c.votos, 0) : 0;
const cambio = (siglas: string, escanos: number) => {
  const antes = p.candidaturas.find((c) => c.siglas === siglas);
  if (!antes) return 'nueva';
  const d = escanos - antes.escanos;
  return d === 0 ? '=' : d > 0 ? `+${d}` : `${d}`;
};
const hora = resultados2026
  ? new Date(resultados2026.actualizado).toLocaleString('es-ES', { day: 'numeric', month: 'long', hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Madrid' })
  : '';

// Lo mínimo para el simulador en el navegador
const datos = {
  escanos: p.escanos2026,
  votosValidos: p.votosValidos,
  candidaturas: principales.map((c) => ({ siglas: c.siglas, votos: c.votos, color: color(c.siglas) })),
  otros,
};
const presentadas = candidaturas2026.provincias.find((x) => x.id === p.id);
---

<Base imagen={`/og/${p.slug}.png`} title={`${p.nombre} el 29 de noviembre: diputados y candidaturas · tuvotocuenta`} description={`${p.nombre} elige ${p.escanos2026} ${palabra(p.escanos2026)} el 29 de noviembre. Cómo se repartieron en 2023 y cuántos votos cuesta un escaño.`}>
  <a href="/tu-voto" class="volver suave">← Todas las provincias</a>
  <h1>{p.nombre}</h1>
  <dl class="cifras-cabecera">
    <div><dt class="cifra">{p.escanos2026}</dt><dd>{palabra(p.escanos2026)} {r26 ? 'elegidos' : 'elige'} el 29 de noviembre{diferencia !== 0 && `, ${Math.abs(diferencia)} ${diferencia > 0 ? 'más' : 'menos'} que en 2023`}</dd></div>
    {presentadas && <div><dt class="cifra">{presentadas.candidaturas.length}</dt><dd>candidaturas se presentan</dd></div>}
    <div><dt class="cifra">{n(Math.round(p.votosValidos / p.escanos2023))}</dt><dd>votos costó un escaño en 2023</dd></div>
  </dl>
  <Fuente de={presentadas ? ['convocatoria2026', 'candidaturas2026', 'resultados2023'] : ['convocatoria2026', 'resultados2023']} calculo />

  <div class="acciones" data-provincia-actual data-slug={p.slug} data-nombre={p.nombre}>
    <nav class="saltos" aria-label="Ir a una sección">
      {r26 && <a href="#resultado">Resultado</a>}
      {presentadas && <a href="#quien">Quién se presenta</a>}
      <a href="#reparto-2023">2023</a>
      <a href="#simular">Simular</a>
    </nav>
  </div>

  {r26 && resultados2026 && (
    <section class="r26" id="resultado">
      <h2>Resultado del 29 de noviembre</h2>
      <p class="estado suave">
        {resultados2026.provisional ? `Provisional · escrutado el ${resultados2026.escrutado.toLocaleString('es-ES')} %` : 'Resultado definitivo'} · actualizado el {hora}
      </p>
      <Escanos reparto={r26.candidaturas} />
      <table class="tabla">
        <thead>
          <tr><th>Candidatura</th><th class="num">Votos</th><th class="num">%</th><th class="num">Escaños</th><th class="num">vs. 2023</th></tr>
        </thead>
        <tbody>
          {principales26.map((c) => (
            <tr>
              <td><span class="punto" style={`--c:${color(c.siglas)}`}></span>{c.siglas}</td>
              <td class="num cifra">{n(c.votos)}</td>
              <td class="num cifra">{pct(c.votos / r26.votosValidos)}</td>
              <td class="num cifra">{c.escanos || '–'}</td>
              <td class="num cifra suave">{cambio(c.siglas, c.escanos)}</td>
            </tr>
          ))}
          {otros26 > 0 && (
            <tr class="fuera">
              <td><span class="punto" style="--c:transparent"></span>Otras</td>
              <td class="num cifra">{n(otros26)}</td>
              <td class="num cifra">{pct(otros26 / r26.votosValidos)}</td>
              <td class="num cifra">–</td>
              <td class="num"></td>
            </tr>
          )}
        </tbody>
      </table>
      <p class="suave nota">«vs. 2023» compara con la candidatura de las mismas siglas; «nueva» indica que no se presentó con esas siglas en 2023.</p>
      <span class="fuente-26">Fuente: <a href={resultados2026.fuente.url} target="_blank" rel="noopener">{resultados2026.fuente.nombre}</a></span>
    </section>
  )}

  {presentadas && (
    <section class="presentadas" id="quien">
      <h2>Quién se presenta</h2>
      <p class="suave nota-cand">En el orden del BOE. Pulsa una para ver su lista.</p>
      <ul>
        {presentadas.candidaturas.map((c) => (
          <li>
            <details>
              <summary>{c.texto}</summary>
              <ol>{c.candidatos.map((n) => <li>{n}</li>)}</ol>
            </details>
          </li>
        ))}
      </ul>
      <Fuente de={['candidaturas2026', 'candidaturas2026correccion', 'loreg']} detalle="art. 49 de la ley electoral" />
    </section>
  )}

  <h2 id="reparto-2023">Así se repartieron en 2023</h2>
  <Escanos reparto={p.candidaturas} />

  <table class="tabla">
    <thead>
      <tr><th>Candidatura</th><th class="num">Votos</th><th class="num">%</th><th class="num">Escaños</th></tr>
    </thead>
    <tbody>
      {principales.map((c) => (
        <tr class:list={{ fuera: c.votos < umbral }}>
          <td><span class="punto" style={`--c:${color(c.siglas)}`}></span>{c.siglas}</td>
          <td class="num cifra">{n(c.votos)}</td>
          <td class="num cifra">{pct(c.votos / p.votosValidos)}</td>
          <td class="num cifra">{c.escanos || '–'}</td>
        </tr>
      ))}
      {otros > 0 && (
        <tr class="fuera">
          <td><span class="punto" style="--c:transparent"></span>Otras</td>
          <td class="num cifra">{n(otros)}</td>
          <td class="num cifra">{pct(otros / p.votosValidos)}</td>
          <td class="num cifra">–</td>
        </tr>
      )}
    </tbody>
  </table>
  <Fuente de="resultados2023" />

  <h2>Lo que conviene saber</h2>
  <dl class="datos">
    <div>
      <dt class="cifra">{n(umbral)}</dt>
      <dd>votos, el 3 % de los válidos, era el mínimo para poder optar a un escaño.<Fuente de={['resultados2023', 'loreg']} calculo /></dd>
    </div>
    {ultimo && (
      <div>
        <dt class="cifra">{n(ultimo.faltaron)}</dt>
        <dd>votos más habría necesitado {ultimo.aspirante.siglas} para quitarle el último escaño a {ultimo.ganador.siglas}.<Fuente de={['resultados2023', 'loreg']} calculo /></dd>
      </div>
    )}
    <div>
      <dt class="cifra">{pct(p.votantes / p.censo)}</dt>
      <dd>del censo votó en 2023.<Fuente de="resultados2023" calculo /></dd>
    </div>
  </dl>

  <h2>En blanco, nulo o abstención</h2>
  <dl class="tipos">
    <div>
      <dt>Voto en blanco</dt>
      <dd>
        Es el sobre sin papeleta. La ley lo considera un voto válido, así que cuenta para calcular el mínimo del 3 % y lo sube un poco. No da escaño a nadie.
        <Fuente de="loreg" detalle="arts. 96.5 y 163.1" />
      </dd>
    </div>
    <div>
      <dt>Voto nulo</dt>
      <dd>
        Una papeleta tachada o con algo escrito, dos papeletas de partidos distintos en el mismo sobre o un sobre que no es el oficial. No cuenta en el reparto.
        <Fuente de="loreg" detalle="art. 96" />
      </dd>
    </div>
    <div>
      <dt>Abstención</dt>
      <dd>
        No votar. Tampoco cuenta: el reparto se hace solo con los votos emitidos.
        <Fuente de="loreg" detalle="art. 163.1" />
      </dd>
    </div>
  </dl>
  <p class="local">
    En {p.nombre} hubo en 2023 <strong class="cifra">{n(p.blanco)}</strong> votos en blanco y <strong class="cifra">{n(p.nulos)}</strong> nulos.
    Los votos en blanco subieron el mínimo del 3 % en {n(Math.round(p.blanco * UMBRAL))} votos.
  </p>
  <Fuente de={['resultados2023', 'loreg']} calculo />

  <h2 id="simular">¿Y si cambian los votos?</h2>
  <p class="suave">Mueve votos de una candidatura a otra y mira cómo quedarían los {p.escanos2026} escaños de 2026, partiendo de los votos de 2023.</p>

  <div class="simulador" data-simulador data-datos={JSON.stringify(datos)}>
    <div class="controles">
      <label>Quitar votos a <span class="desplegable"><select name="de">{principales.map((c, i) => <option value={i} selected={i === 0}>{c.siglas}</option>)}</select></span></label>
      <label>y dárselos a <span class="desplegable"><select name="a">{principales.map((c, i) => <option value={i} selected={i === 1}>{c.siglas}</option>)}</select></span></label>
    </div>
    <label class="deslizador">
      <span class="deslizador-texto"><span>Porcentaje de sus votos</span><strong class="cifra" data-pct>0 %</strong></span>
      <input type="range" name="pct" min="0" max="50" step="1" value="0" />
      <span class="suave cifra votos-movidos" data-votos>Ningún voto cambia todavía.</span>
    </label>
    <div class="escanos" data-escanos role="img" aria-label="Reparto simulado de escaños"></div>
    <ul class="reparto" data-reparto aria-live="polite"></ul>
    <p class="cambio" data-cambio aria-live="polite"></p>
  </div>
  <p class="suave nota">Reparto por la ley D'Hondt con mínimo del 3 % (art. 163 de la LOREG).</p>

  <Fuente de={['resultados2023', 'convocatoria2026', 'loreg']} calculo />
</Base>

<script>
  import { repartir } from '../../lib/dhondt';

  interface Datos {
    escanos: number;
    votosValidos: number;
    candidaturas: { siglas: string; votos: number; color: string }[];
  }

  // Se recuerda la última provincia consultada para ofrecerla en la portada y en «Tu voto»
  function recordar() {
    const el = document.querySelector<HTMLElement>('[data-provincia-actual]');
    if (!el) return;
    try {
      localStorage.setItem('provincia', JSON.stringify({ slug: el.dataset.slug, nombre: el.dataset.nombre }));
    } catch {}
  }
  document.addEventListener('astro:page-load', recordar);
  recordar();

  function iniciar() {
    const el = document.querySelector<HTMLElement>('[data-simulador]');
    if (!el || el.dataset.iniciado) return;
    el.dataset.iniciado = '1';
    const datos: Datos = JSON.parse(el.dataset.datos!);
    const de = el.querySelector<HTMLSelectElement>('[name=de]')!;
    const a = el.querySelector<HTMLSelectElement>('[name=a]')!;
    const rango = el.querySelector<HTMLInputElement>('[name=pct]')!;
    const caja = el.querySelector<HTMLElement>('[data-escanos]')!;
    const lista = el.querySelector<HTMLElement>('[data-reparto]')!;
    const cambio = el.querySelector<HTMLElement>('[data-cambio]')!;
    const fmt = (x: number) => x.toLocaleString('es-ES', { useGrouping: 'always' } as Intl.NumberFormatOptions);

    const reparto = (votos: number[]) => repartir(votos.map((v, i) => ({ id: String(i), votos: v })), datos.escanos, datos.votosValidos);
    const base = reparto(datos.candidaturas.map((c) => c.votos));
    const escanosBase = (k: number) => base.get(String(k)) ?? 0;

    function pintar() {
      const i = Number(de.value);
      const j = Number(a.value);
      const pct = Number(rango.value);
      const movidos = Math.round((datos.candidaturas[i].votos * pct) / 100);
      const votos = datos.candidaturas.map((c, k) => c.votos - (k === i ? movidos : 0) + (k === j ? movidos : 0));
      const r = reparto(votos);
      const escanos = (k: number) => r.get(String(k)) ?? 0;

      el!.querySelector('[data-pct]')!.textContent = `${pct} %`;
      rango.style.setProperty('--p', `${(pct / Number(rango.max)) * 100}%`);
      el!.querySelector('[data-votos]')!.textContent = movidos
        ? `${fmt(movidos)} votos pasan de ${datos.candidaturas[i].siglas} a ${datos.candidaturas[j].siglas}.`
        : 'Ningún voto cambia todavía.';
      rango.setAttribute('aria-valuetext', `${pct} % de los votos de ${datos.candidaturas[i].siglas}${movidos ? `, ${fmt(movidos)} votos` : ''}`);

      // Puntos de escaños, en el mismo orden de partidos
      const asientos = datos.candidaturas.flatMap((c, k) => Array.from({ length: escanos(k) }, () => c));
      const puntos = [...caja.children] as HTMLElement[];
      asientos.forEach((c, k) => {
        const s = puntos[k] ?? caja.appendChild(document.createElement('span'));
        s.style.setProperty('--c', c.color);
        s.title = c.siglas;
      });
      caja.setAttribute('aria-label', `Reparto simulado: ${datos.candidaturas.map((c, k) => `${c.siglas} ${escanos(k)}`).join(', ')}`);

      // Escaños de cada candidatura: los de 2023 y los simulados
      lista.replaceChildren(
        ...datos.candidaturas
          .map((c, k) => ({ c, k, antes: escanosBase(k), ahora: escanos(k) }))
          .filter((x) => x.antes > 0 || x.ahora > 0 || x.k === i || x.k === j)
          .map((x) => {
            const li = document.createElement('li');
            const d = x.ahora - x.antes;
            li.className = d > 0 ? 'gana' : d < 0 ? 'pierde' : '';
            li.innerHTML = `<span class="nombre"><span class="punto" style="--c:${x.c.color}"></span></span><span class="cifra num"></span><span class="cifra dif"></span>`;
            li.querySelector('.nombre')!.append(x.c.siglas);
            li.querySelector('.num')!.textContent = String(x.ahora);
            li.querySelector('.dif')!.textContent = d === 0 ? '' : `${d > 0 ? '+' : ''}${d}`;
            return li;
          }),
      );

      const cambian = datos.candidaturas.some((_, k) => escanos(k) !== escanosBase(k));
      cambio.textContent = !movidos ? 'Mueve el control para pasar votos.' : cambian ? 'Con este cambio, el reparto sería distinto.' : 'Con este cambio, el reparto sería el mismo.';
    }

    // No se pueden pasar votos a la misma candidatura: se elige otra automáticamente
    const distinta = (fija: HTMLSelectElement, otra: HTMLSelectElement) => {
      if (fija.value === otra.value) otra.value = String((Number(fija.value) + 1) % datos.candidaturas.length);
    };
    de.addEventListener('change', () => (distinta(de, a), pintar()));
    a.addEventListener('change', () => (distinta(a, de), pintar()));
    rango.addEventListener('input', pintar);
    rango.addEventListener('change', pintar);
    pintar();
  }

  document.addEventListener('astro:page-load', iniciar);
  iniciar();
</script>

<style>
  .acciones { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px; margin-top: 20px; }
  .saltos { display: flex; flex-wrap: wrap; gap: 6px; }
  .saltos a { display: inline-flex; align-items: center; min-height: 40px; padding: 0 14px; border-radius: 999px; background: var(--resalte); font-size: 14px; text-decoration: none; transition: background-color 0.15s; }
  .saltos a:hover { background: var(--linea); }
  h2[id], section[id] { scroll-margin-top: 16px; }
  .presentadas { margin-top: 32px; }
  .nota-cand { font-size: 14px; margin: 0 0 8px; }
  .presentadas ul { list-style: none; margin: 0; padding: 0; }
  .presentadas > ul > li { border-bottom: 1px solid var(--linea); font-size: 14px; }
  .presentadas summary { cursor: pointer; padding: 12px 0; overflow-wrap: anywhere; }
  .presentadas ol { margin: 0 0 12px; padding-left: 24px; }
  .presentadas ol li { padding: 2px 0; }
  .volver { display: inline-block; margin-top: 24px; font-size: 15px; text-decoration: none; }
  .volver:hover { color: var(--tinta); }
  .entradilla { font-size: 19px; margin: 0; }
  @media (min-width: 640px) { .entradilla { font-size: 22px; } }
  .entradilla strong { font-weight: 600; }

  .tabla { width: 100%; border-collapse: collapse; font-size: 14px; }
  .tabla th { text-align: left; font-weight: 500; color: var(--suave); font-size: 13px; padding: 8px 0; border-bottom: 1px solid var(--linea); }
  .tabla td { padding: 10px 0; border-bottom: 1px solid var(--linea); }
  .tabla .num { text-align: right; padding-left: 8px; white-space: nowrap; }
  .tabla td:first-child { overflow-wrap: anywhere; }
  .fuera td { color: var(--suave); }
  .estado { font-size: 14px; margin: 0; }
  .fuente-26 { display: block; margin-top: 6px; font-size: 13px; color: var(--suave); }
  .fuente-26 a { color: var(--suave); }
  .punto { display: inline-block; width: 10px; height: 10px; border-radius: 50%; background: var(--c); margin-right: 10px; }

  .datos { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 28px 32px; margin: 24px 0 0; }
  .datos div { border-top: 1px solid var(--tinta); padding-top: 12px; }
  .datos dt { font-family: var(--serif); font-size: 44px; line-height: 1; }
  .datos dd { margin: 8px 0 0; color: var(--suave); font-size: 15px; }

  .tipos { margin: 16px 0 0; }
  .tipos div { padding: 14px 0; border-bottom: 1px solid var(--linea); }
  .tipos dt { font-weight: 600; }
  .tipos dd { margin: 4px 0 0; }
  .local { margin: 16px 0 0; }
  .local strong { font-weight: 600; }

  .simulador { margin-top: 24px; padding: 20px 16px; background: var(--resalte); border-radius: 14px; }
  .controles { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .controles label { display: flex; flex-direction: column; gap: 6px; font-size: 13px; color: var(--suave); }
  .controles .desplegable, .controles select { width: 100%; max-width: none; }
  /* Desplegable propio: flecha dibujada con CSS para que no se corte y siga el tema */
  .desplegable { position: relative; display: inline-flex; }
  .desplegable::after {
    content: '';
    position: absolute;
    right: 14px;
    top: 50%;
    width: 7px;
    height: 7px;
    border-right: 1.5px solid var(--tinta);
    border-bottom: 1.5px solid var(--tinta);
    transform: translateY(-70%) rotate(45deg);
    pointer-events: none;
  }
  select {
    appearance: none;
    -webkit-appearance: none;
    font: inherit;
    font-size: 16px;
    color: var(--tinta);
    background: var(--papel);
    border: 1px solid var(--linea);
    border-radius: 10px;
    height: 46px;
    padding: 0 36px 0 14px;
    min-width: 0;
    cursor: pointer;
    transition: border-color 0.15s;
  }
  select:hover { border-color: var(--suave); }
  .deslizador { display: flex; flex-direction: column; gap: 8px; margin: 22px 0 4px; }
  .deslizador-texto { display: flex; justify-content: space-between; align-items: baseline; font-size: 14px; }
  .deslizador-texto strong { font-family: var(--serif); font-weight: 400; font-size: 30px; line-height: 1; }
  .votos-movidos { font-size: 13px; min-height: 1.4em; }
  /* Deslizador: pista con la parte recorrida en tinta y tirador grande, fácil de usar con el dedo */
  input[type='range'] {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 36px;
    margin: 0;
    background: transparent;
    cursor: pointer;
    touch-action: pan-y;
  }
  input[type='range']::-webkit-slider-runnable-track { height: 6px; border-radius: 3px; background: linear-gradient(to right, var(--tinta) var(--p, 0%), var(--linea) var(--p, 0%)); }
  input[type='range']::-moz-range-track { height: 6px; border-radius: 3px; background: var(--linea); }
  input[type='range']::-moz-range-progress { height: 6px; border-radius: 3px; background: var(--tinta); }
  input[type='range']::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 30px;
    height: 30px;
    margin-top: -12px;
    border-radius: 50%;
    background: var(--papel);
    border: 2px solid var(--tinta);
  }
  input[type='range']::-moz-range-thumb { width: 26px; height: 26px; border-radius: 50%; background: var(--papel); border: 2px solid var(--tinta); }
  .simulador .escanos { margin: 16px 0 12px; }
