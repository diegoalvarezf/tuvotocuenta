---
import Base from '../../layouts/Base.astro';
import Fuente from '../../components/Fuente.astro';
import TuProvincia from '../../components/TuProvincia.astro';
import { provincias } from '../../lib/provincias';

const lista = [...provincias].sort((a, b) => a.slug.localeCompare(b.slug, 'es'));
const votosPorEscano = (p: (typeof provincias)[number]) => Math.round(p.votosValidos / p.escanos2023);
const extremos = [...provincias].sort((a, b) => votosPorEscano(a) - votosPorEscano(b));
const barato = extremos[0];
const caro = extremos[extremos.length - 1];
const maximo = Math.max(...provincias.map((p) => p.escanos2026));
const n = (x: number) => x.toLocaleString('es-ES', { useGrouping: 'always' } as Intl.NumberFormatOptions);
---

<Base title="Diputados por provincia el 29 de noviembre · tuvotocuenta" description="Las 52 circunscripciones de las elecciones generales del 29 de noviembre: cuántos diputados elige cada una, quién se presenta y cuántos votos costó un escaño en 2023.">
  <h1>Tu voto en<br /><em>tu provincia</em></h1>
  <p class="entradilla">Cada provincia elige a sus diputados, y después el Congreso elige al presidente.</p>
  <Fuente de="constitucion" detalle="art. 99" />

  <dl class="cifras-cabecera">
    <div><dt class="cifra">52</dt><dd>circunscripciones</dd></div>
    <div><dt class="cifra">350</dt><dd>diputados en juego</dd></div>
    <div><dt class="cifra">×{(votosPorEscano(caro) / votosPorEscano(barato)).toLocaleString('es-ES', { maximumFractionDigits: 1 })}</dt><dd>cuesta más un escaño en {caro.nombre} que en {barato.nombre}</dd></div>
  </dl>
  <Fuente de={['convocatoria2026', 'resultados2023']} calculo />

  <a class="a-senado" href="/tu-voto/senado">
    <span class="a-senado-titulo">¿Y el Senado? <span class="flecha" aria-hidden="true">→</span></span>
    <span class="suave">Se vota a personas, en otra papeleta. Cuántos nombres marcar y qué anula el voto.</span>
  </a>

  <TuProvincia />

  <label class="buscar">
    <span class="visually-hidden">Busca tu provincia</span>
    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="M16 16l4.5 4.5" /></svg>
    <input type="search" placeholder="Busca tu provincia" autocomplete="off" data-buscar />
  </label>

  <ul class="provincias" data-lista>
    {lista.map((p) => (
      <li data-nombre={`${p.nombre} ${p.slug}`.toLowerCase().normalize('NFD').replace(/\p{M}/gu, '')}>
        <a href={`/tu-voto/${p.slug}`}>
          <span class="nombre">{p.nombre}</span>
          <span class="escanos"><strong class="cifra">{p.escanos2026}</strong> <span class="suave">{p.escanos2026 === 1 ? 'diputado' : 'diputados'}</span></span>
          <span class="barra-escanos" style={`--w:${(p.escanos2026 / maximo) * 100}%`} aria-hidden="true"></span>
        </a>
      </li>
    ))}
  </ul>
  <p class="suave nota" data-sin-resultados hidden>Ninguna provincia coincide con la búsqueda.</p>
  <Fuente de="convocatoria2026" />
</Base>

<script>
  function iniciar() {
    const input = document.querySelector<HTMLInputElement>('[data-buscar]');
    const items = document.querySelectorAll<HTMLElement>('[data-lista] li');
    if (!input || input.dataset.iniciado) return;
    input.dataset.iniciado = '1';
    input.addEventListener('input', () => {
      const q = input.value.toLowerCase().normalize('NFD').replace(/\p{M}/gu, '').trim();
      items.forEach((li) => (li.hidden = !!q && !li.dataset.nombre!.includes(q)));
      document.querySelector<HTMLElement>('[data-sin-resultados]')!.hidden = [...items].some((li) => !li.hidden);
    });
    input.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter') return;
      const primero = [...items].find((li) => !li.hidden)?.querySelector('a');
      primero?.click();
    });
  }
  document.addEventListener('astro:page-load', iniciar);
  iniciar();
</script>

<style>
  h1 em { font-style: italic; }
  .entradilla { font-size: var(--entradilla); max-width: 40ch; margin: 0; }

  /* Buscador: campo con borde, lupa y altura cómoda para el dedo */
  .buscar { position: relative; display: block; margin: 28px 0 8px; }
  .buscar svg { position: absolute; left: 16px; top: 50%; width: 20px; height: 20px; transform: translateY(-50%); fill: none; stroke: var(--suave); stroke-width: 1.8; stroke-linecap: round; pointer-events: none; }
  input[type='search'] {
    width: 100%;
    font: inherit;
    font-size: 17px;
    color: var(--tinta);
    background: var(--papel);
    border: 1px solid var(--linea);
    border-radius: 999px;
    min-height: 52px;
    padding: 0 18px 0 46px;
    -webkit-appearance: none;
    appearance: none;
    transition: border-color 0.15s;
  }
  input[type='search']:focus { outline: none; border-color: var(--tinta); }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  /* Provincias: nombre, diputados en grande y una barra proporcional a los escaños */
  .provincias { list-style: none; padding: 0; margin: 8px 0 0; display: grid; grid-template-columns: 1fr 1fr; column-gap: 16px; }
  .provincias li[hidden] { display: none; }
  .provincias a { position: relative; display: flex; flex-direction: column; gap: 2px; padding: 14px 0 16px; border-bottom: 1px solid var(--linea); text-decoration: none; }
  .nombre { font-size: 15px; line-height: 1.25; overflow-wrap: anywhere; }
  .escanos { font-size: 13px; }
  .escanos strong { font-family: var(--serif); font-weight: 400; font-size: 26px; line-height: 1; margin-right: 2px; }
  .barra-escanos { position: absolute; left: 0; bottom: -1px; height: 2px; width: var(--w); background: var(--tinta); transform-origin: left; transition: transform 0.3s ease; }
  .provincias a:hover .nombre { text-decoration: underline; }
  .nota { font-size: 13px; margin-top: 16px; }
  .a-senado { display: flex; flex-direction: column; gap: 2px; margin-top: 24px; padding: 14px 16px; border: 1px solid var(--tinta); border-radius: 14px; text-decoration: none; font-size: 15px; }
  .a-senado-titulo { display: flex; justify-content: space-between; font-weight: 600; }
  .a-senado .flecha { transition: transform 0.2s ease; }
  .a-senado:hover .flecha { transform: translateX(4px); }
  @media (prefers-reduced-motion: reduce) { .a-senado .flecha { transition: none; } }
  @media (min-width: 640px) {
    .provincias { grid-template-columns: repeat(3, 1fr); column-gap: 28px; }
  }
</style>
