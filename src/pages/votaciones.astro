---
import Base from '../layouts/Base.astro';
import Fuente from '../components/Fuente.astro';
import Coincidencias from '../components/Coincidencias.astro';
import votaciones from '../data/votaciones.json';
import pendientes from '../data/decretos-pendientes.json';
import decretos from '../data/decretos.json';
import programas2023 from '../data/programas-2023.json';
import citas2023 from '../data/votaciones-programas-2023.json';
import { color, colorGrupo, nombreGrupo } from '../lib/partidos';

const n = (x: number) => x.toLocaleString('es-ES', { useGrouping: 'always' } as Intl.NumberFormatOptions);
const fecha = (f: string) =>
  new Date(f + 'T12:00:00').toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
// Citas de los programas de 2023 relacionadas con cada votación (clave: fichero de la votación)
const citasDe = (id: string) => (citas2023 as Record<string, { partido: keyof typeof programas2023; pagina: number; cita: string }[]>)[id.replace('-', '/') + '.json'] ?? [];
const VOTO: Record<string, string> = { si: 'Sí', no: 'No', abstencion: 'Abstención', noVota: 'No vota', dividido: 'Dividido' };
// Grupos agrupados por lo que votó la mayoría de sus diputados
const SENTIDOS = ['si', 'no', 'abstencion', 'dividido', 'noVota'];
const porSentido = (grupos: (typeof votaciones)[number]['grupos']) =>
  SENTIDOS.map((s) => ({ sentido: s, grupos: grupos.filter((g) => g.sentido === s) })).filter((x) => x.grupos.length > 0);
const temas = [...new Set(votaciones.map((v) => v.tema))].sort((a, b) => a.localeCompare(b, 'es'));
const aprobadas = votaciones.filter((v) => v.gana === 'si').length;
// Decretos votados por la Diputación Permanente con las Cortes disueltas (resultado del BOE; votos, si los hay, de la nota del Congreso)
// Votados por la Diputación Permanente: con el acuerdo ya en el BOE (decretos.json) o, mientras no se publica, con la nota
// de prensa del Congreso (decretos-pendientes.json con resultado)
type VotadoDP = { nombre: string; titulo: string; votacion: string; resultado: string; totales: { si: number; no: number; abstencion?: number } | null; boe?: string; fuenteVotos?: { nombre: string; url: string }; fuenteResultado?: { nombre: string; url: string } };
const votadosDP: VotadoDP[] = [
  ...pendientes.filter((d) => d.resultado).map((d) => ({ ...d, titulo: d.titulo.replace(/\.$/, ''), boe: undefined, textoBoe: d.boe }) as unknown as VotadoDP),
  ...(decretos.filter((d) => d.organo === 'Diputación Permanente') as unknown as VotadoDP[]),
].sort((a, b) => b.votacion.localeCompare(a.votacion) || b.nombre.localeCompare(a.nombre, 'es', { numeric: true }));
const sinVotar = pendientes.filter((d) => !d.resultado);
// Los votados, agrupados por sesión: la fecha se dice una vez y cada decreto ocupa tres líneas.
// Solo la última sesión queda a la vista; las anteriores se despliegan.
const sesionesDP = [...new Set(votadosDP.map((d) => d.votacion))].map((dia) => ({ dia, decretos: votadosDP.filter((d) => d.votacion === dia) }));
const convalidadosDP = votadosDP.filter((d) => d.resultado === 'convalidado').length;
const derogadosDP = votadosDP.length - convalidadosDP;
const corto = (nombre: string) => nombre.replace('Real Decreto-ley', 'RDL');
const fechaCorta = (iso: string) => new Date(`${iso}T12:00:00`).toLocaleDateString('es-ES', { day: 'numeric', month: 'long' });
const derogados = decretos.filter((d) => d.resultado === 'derogado');
const totalDecretos = decretos.length + pendientes.filter((d) => d.resultado).length;
const mayuscula = (t: string) => t.charAt(0).toUpperCase() + t.slice(1);
---

<Base title="Qué votó cada partido en el Congreso (2023-2026) · tuvotocuenta" description="Votaciones clave del Congreso en la legislatura 2023-2026: qué se votó y qué votó cada grupo, con el acta oficial.">
  <h1>Lo que<br /><em>votaron</em></h1>
  <p class="entradilla">Qué se votaba, qué votó cada grupo y el acta oficial de cada una.</p>

  <dl class="cifras-cabecera">
    <div><dt class="cifra">{votaciones.length}</dt><dd>votaciones clave de 2023 a 2026</dd></div>
    <div><dt class="cifra">{aprobadas}<span class="suave"> / </span>{votaciones.length - aprobadas}</dt><dd>ganó el sí / ganó el no</dd></div>
    <div><dt class="cifra">{derogados.length}<span class="suave"> de </span>{totalDecretos}</dt><dd>decretos ley del Gobierno tumbados</dd></div>
  </dl>
  <Fuente de="votacionesCongreso" />
  <p class="suave nota">
    Las 2.175 votaciones del Pleno de la legislatura, en <a href="/descargas/votaciones-xv-legislatura.pdf" download>PDF</a> o <a href="/descargas/votaciones-xv-legislatura.csv" download>CSV</a>.
  </p>
  <details class="derogados">
    <summary>Ver los {derogados.length} decretos ley tumbados</summary>
    <ul>
      {derogados.map((d) => (
        <li>
          <span class="suave">{fecha(d.votacion)} · </span>{d.titulo.charAt(0).toUpperCase() + d.titulo.slice(1)}.
          {d.sinDatosAbiertos && <span class="suave"> Esta votación no figura en los datos abiertos del Congreso.</span>}
          <span class="fuente-nota">Fuente: <a href={d.boe} target="_blank" rel="noopener">acuerdo de derogación del {d.nombre} (BOE)</a></span>
        </li>
      ))}
    </ul>
  </details>


  <Coincidencias />

  {pendientes.length > 0 && (
    <section class="pendientes" aria-labelledby="pendientes-titulo">
      <h2 id="pendientes-titulo">Decretos con las Cortes disueltas</h2>
      <p>Los vota la Diputación Permanente del Congreso, que decide si se mantienen o se derogan.</p>
      <Fuente de="constitucion" detalle="arts. 78.2 y 86.2" />
      <p class="resumen-dp">
        <strong>{votadosDP.length}</strong> votados ({convalidadosDP} convalidados{derogadosDP > 0 && ` y ${derogadosDP} ${derogadosDP === 1 ? 'derogado' : 'derogados'}`}){sinVotar.length > 0 && <> · <strong>{sinVotar.length}</strong> pendientes de votar</>}
      </p>
      {sinVotar.length > 0 && (
        <>
          <h3>Pendientes de votar</h3>
          <ul>
            {sinVotar.map((d) => (
              <li>
                <p class="titulo-pendiente">{d.titulo.replace(/\.$/, '')}</p>
                <p class="linea-dp suave">{corto(d.nombre)} · publicado el <time datetime={d.fecha}>{fechaCorta(d.fecha)}</time> · <a href={d.boe} target="_blank" rel="noopener" aria-label={`${d.nombre} (BOE)`}>BOE</a></p>
                {d.nota && (
                  <p class="nota-pendiente suave">
                    {d.nota} <span class="fuente-nota">Fuente: <a href={d.notaFuente!.url} target="_blank" rel="noopener">{d.notaFuente!.nombre}</a></span>
                  </p>
                )}
              </li>
            ))}
          </ul>
        </>
      )}
      {[sesionesDP.slice(0, 1), sesionesDP.slice(1)].map((grupo, i) => {
        const sesiones = grupo.map((sesion) => (
          <>
            <h3>Votados el <time datetime={sesion.dia}>{fechaCorta(sesion.dia)}</time></h3>
            <ul>
              {sesion.decretos.map((d) => (
                <li>
                  <p class="titulo-pendiente">{mayuscula(d.titulo)}</p>
                  <p class="linea-dp">
                    <strong class:list={['estado', d.resultado]}>{d.resultado === 'convalidado' ? 'Convalidado' : 'Derogado'}</strong>
                    {d.totales && <span class="cifra suave"> · {d.totales.si} a favor, {d.totales.no} en contra{d.totales.abstencion ? `, ${d.totales.abstencion} ${d.totales.abstencion === 1 ? 'abstención' : 'abstenciones'}` : ''}</span>}
                  </p>
                  <p class="linea-dp suave">
                    {corto(d.nombre)} · Fuente:{' '}
                    {d.boe ? (
                      <a href={d.boe} target="_blank" rel="noopener" aria-label={`Acuerdo de ${d.resultado === 'convalidado' ? 'convalidación' : 'derogación'} del ${d.nombre} (BOE)`}>BOE</a>
                    ) : (
                      <a href={d.fuenteResultado!.url} target="_blank" rel="noopener" aria-label={d.fuenteResultado!.nombre}>Congreso</a>
                    )}
                    {d.fuenteVotos && <> y <a href={d.fuenteVotos.url} target="_blank" rel="noopener" aria-label={d.fuenteVotos.nombre}>Congreso</a></>}
                  </p>
                </li>
              ))}
            </ul>
          </>
        ));
        if (i === 0) return sesiones;
        return grupo.length > 0 && (
          <details>
            <summary>Ver los {grupo.reduce((n, x) => n + x.decretos.length, 0)} decretos votados en sesiones anteriores</summary>
            {sesiones}
          </details>
        );
      })}
    </section>
  )}

  <h2 class="titulo-lista" id="lista">Las votaciones</h2>
  <nav class="temas" aria-label="Filtrar por tema" data-filtro-votaciones>
    <button type="button" aria-pressed="true" data-tema="">Todas</button>
    {temas.map((t) => <button type="button" aria-pressed="false" data-tema={t}>{t}</button>)}
  </nav>

  <button type="button" class="pildora" data-burbuja aria-haspopup="dialog" aria-label="Abrir el índice de votaciones">
    <span data-posicion>1 de {votaciones.length}</span>
    <span class="separador" aria-hidden="true"></span>
    <span>Índice</span>
    <span class="flecha-arriba" aria-hidden="true"></span>
  </button>
  <dialog class="panel" data-panel aria-label="Índice de votaciones">
    <div class="asa" aria-hidden="true"></div>
    <div class="panel-cabecera">
      <a href="#" class="arriba" data-arriba><span aria-hidden="true">↑</span> Volver al principio</a>
      <button type="button" class="cerrar" data-cerrar aria-label="Cerrar el índice"><span aria-hidden="true"></span></button>
    </div>
    <ol>
      {votaciones.map((v, i) => (
        <li data-tema={v.tema}>
          <a href={`#${v.id}`} data-indice={v.id}>
            <span class="numero cifra">{String(i + 1).padStart(2, '0')}</span>
            <span class="texto">
              <span class="nombre">{v.nombre}</span>
              <span class="meta">{v.tema}</span>
            </span>
          </a>
        </li>
      ))}
    </ol>
  </dialog>

  <aside class="indice-lateral" aria-label="Índice de votaciones">
    <p class="suave">Votaciones</p>
    <ol>
      {votaciones.map((v) => (
        <li data-tema={v.tema}><a href={`#${v.id}`} data-indice={v.id}>{v.nombre}</a></li>
      ))}
    </ol>
  </aside>

  <ol class="lista">
    {votaciones.map((v) => (
      <li class="votacion" data-tema={v.tema} id={v.id}>
        <p class="meta suave">
          <time datetime={v.fecha}>{fecha(v.fecha)}</time> · {v.tema}
        </p>
        <h2>{v.nombre}</h2>
        <p class="resumen">{v.resumen}</p>

        <div class="resultado">
          <p class="gana">Ganó el <strong>{v.gana === 'si' ? 'sí' : 'no'}</strong></p>
          <p class="cifras cifra">
            <span><strong>{n(v.totales.si)}</strong> sí</span>
            <span><strong>{n(v.totales.no)}</strong> no</span>
            <span><strong>{n(v.totales.abstencion)}</strong> abst.</span>
          </p>
          <div class="barra" role="img" aria-label={`${v.totales.si} sí, ${v.totales.no} no, ${v.totales.abstencion} abstenciones`}>
            <span class="si" style={`flex:${v.totales.si}`}></span>
            <span class="abst" style={`flex:${v.totales.abstencion}`}></span>
            <span class="no" style={`flex:${v.totales.no}`}></span>
          </div>
          <p class="significa">Votar sí era <strong>{v.siSignifica}</strong>.</p>
        </div>

        <dl class="sentidos">
          {porSentido(v.grupos).map((x) => (
            <div>
              <dt class:list={['voto', x.sentido]}>{VOTO[x.sentido]}</dt>
              <dd>
                <ul>
                  {x.grupos.map((g) => (
                    <li><span class="punto" style={`--c:${colorGrupo(g.codigo)}`}></span>{nombreGrupo(g.nombre)}</li>
                  ))}
                </ul>
              </dd>
            </div>
          ))}
        </dl>
        <p class="sentidos-nota suave">Cada grupo aparece en lo que votó la mayoría de sus diputados.</p>

        {citasDe(v.id).length > 0 && (
          <section class="programa2023">
            <h3>Dentro del programa de 2023</h3>
            <ul>
              {citasDe(v.id).map((c) => (
                <li>
                  <p class="partido-cita"><span class="punto" style={`--c:${color(c.partido)}`}></span>{programas2023[c.partido].corto}</p>
                  <blockquote>«{c.cita}»</blockquote>
                  <span class="fuente-nota">
                    Fuente: <a href={`${programas2023[c.partido].url}#page=${c.pagina}`} target="_blank" rel="noopener">{programas2023[c.partido].titulo}, página {c.pagina}</a>
                  </span>
                </li>
              ))}
            </ul>
          </section>
        )}

        <details class="desglose">
          <summary>Votos de cada grupo, diputado a diputado en el Mixto</summary>
          <ul class="grupos">
            {v.grupos.map((g) => (
              <li>
                <span class="grupo"><span class="punto" style={`--c:${colorGrupo(g.codigo)}`}></span>{nombreGrupo(g.nombre)}</span>
                <span class="detalle suave cifra">
                  {[g.si && `${g.si} sí`, g.no && `${g.no} no`, g.abstencion && `${g.abstencion} abst.`, g.noVota && `${g.noVota} no votan`].filter(Boolean).join(' · ')}
                </span>
              </li>
            ))}
          </ul>
          <p class="suave mixto-nota">El Grupo Mixto reúne a diputados de varias formaciones:</p>
          <ul class="mixto">
            {v.mixto.map((d) => (
              <li><span>{d.diputado}</span><span class="suave">{VOTO[d.voto]}</span></li>
            ))}
          </ul>
        </details>

        {v.nota && (
          <p class="aviso">
            {v.nota}
            {v.notaFuente && <span class="fuente-nota">Fuente: <a href={v.notaFuente.url} target="_blank" rel="noopener">{v.notaFuente.nombre}</a></span>}
          </p>
        )}

        <p class="oficial suave">
          Texto oficial: «{v.oficial.expediente}»{v.oficial.subgrupo && ` ${v.oficial.subgrupo}`}
          <span class="fuente-nota">
            Fuente: Congreso de los Diputados, sesión {v.oficial.sesion}, votación {v.oficial.numero}.{' '}
            <a href={v.enlaces.pdf} target="_blank" rel="noopener">Acta (PDF)</a>{' · '}
            <a href={v.enlaces.json} target="_blank" rel="noopener">Datos (JSON)</a>
          </span>
        </p>
      </li>
    ))}
  </ol>

  <section class="glosario" id="como-leer">
    <h2>Cómo leer estas votaciones</h2>
    <dl>
      <dt>Decreto ley</dt>
      <dd>
        Norma que aprueba el Gobierno en casos de «extraordinaria y urgente necesidad». Se aplica desde que se publica, pero el Congreso debe
        votarla en un plazo de 30 días: si la <strong>convalida</strong>, sigue en vigor; si no, queda derogada.
        <Fuente de="constitucion" detalle="art. 86" />
      </dd>
      <dt>Toma en consideración</dt>
      <dd>
        Votación en la que el Congreso decide si empieza a tramitar una proposición de ley. Que se apruebe no significa que la ley esté aprobada: solo que se va a debatir.
        <Fuente de="reglamentoCongreso" detalle="art. 126" />
      </dd>
      <dt>Enmienda a la totalidad de devolución</dt>
      <dd>
        Petición de un grupo para devolver un proyecto de ley al Gobierno sin debatirlo. Votar sí es apoyar que se devuelva.
        <Fuente de="reglamentoCongreso" detalle="arts. 110 a 112" />
      </dd>
      <dt>Ley orgánica</dt>
      <dd>
        Leyes sobre derechos fundamentales y otras materias que fija la Constitución. Necesitan mayoría absoluta del Congreso (176 votos) en una votación final sobre el conjunto del texto.
        <Fuente de="constitucion" detalle="art. 81" />
      </dd>
      <dt>Por qué estas votaciones</dt>
      <dd>
        Las elegimos con tres criterios: votaciones finales o decisivas (no trámites intermedios), que cubran temas que preocupan a la gente, y que haya tanto aprobadas como rechazadas. Para comprobar cualquier otra, descarga el listado completo.
      </dd>
    </dl>
  </section>
</Base>

<script>
  // Con las transiciones entre páginas, los scripts de todas las páginas visitadas siguen escuchando:
  // cada uno busca su propio elemento y deja de escuchar al salir de la página
  let salir: AbortController | undefined;

  function iniciar() {
    const nav = document.querySelector<HTMLElement>('[data-filtro-votaciones]');
    if (!nav || nav.dataset.iniciado) return;
    nav.dataset.iniciado = '1';
    salir?.abort();
    salir = new AbortController();
    const { signal } = salir;
    document.addEventListener('astro:before-swap', () => salir?.abort(), { once: true, signal });

    const botones = [...nav.querySelectorAll<HTMLButtonElement>('button')];
    const items = [...document.querySelectorAll<HTMLElement>('.votacion')];
    const pildora = document.querySelector<HTMLButtonElement>('[data-burbuja]')!;
    const posicion = pildora.querySelector('[data-posicion]')!;
    const panel = document.querySelector<HTMLDialogElement>('[data-panel]')!;
    const visibles = () => items.filter((li) => !li.hidden);

    botones.forEach((b) =>
      b.addEventListener('click', () => {
        const tema = b.dataset.tema;
        botones.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        items.forEach((li) => (li.hidden = !!tema && li.dataset.tema !== tema));
        // Los índices muestran solo las votaciones del tema elegido
        document.querySelectorAll<HTMLElement>('.panel li, .indice-lateral li').forEach((li) => (li.hidden = !!tema && li.dataset.tema !== tema));
        posicion.textContent = `1 de ${visibles().length}`;
        // Si la lista ya se había pasado, se vuelve a su principio para ver el resultado del filtro
        const titulo = document.getElementById('lista')!;
        if (titulo.getBoundingClientRect().top < 0) titulo.scrollIntoView();
      }),
    );

    // Móvil: píldora flotante que indica la posición y abre el índice; solo mientras se recorre la lista
    const lista = document.querySelector<HTMLElement>('.lista')!;
    const mostrar = () => {
      const r = lista.getBoundingClientRect();
      pildora.classList.toggle('visible', r.top < innerHeight * 0.5 && r.bottom > innerHeight * 0.6);
    };
    addEventListener('scroll', mostrar, { passive: true, signal });
    mostrar();

    const cerrar = () => {
      if (!panel.open || panel.classList.contains('cerrando')) return;
      panel.classList.add('cerrando');
      let hecho = false;
      const fin = () => {
        if (hecho) return;
        hecho = true;
        panel.classList.remove('cerrando');
        panel.close();
      };
      // Sin animación (movimiento reducido) se cierra al momento; si no, al acabar la animación o, como muy tarde, a los 300 ms
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return fin();
      panel.addEventListener('animationend', fin, { once: true });
      setTimeout(fin, 300);
    };
    pildora.addEventListener('click', () => {
      panel.showModal();
      panel.querySelector('a[aria-current]')?.scrollIntoView({ block: 'center' });
    });
    panel.querySelector('[data-cerrar]')!.addEventListener('click', cerrar);
    panel.addEventListener('cancel', (e) => {
      e.preventDefault();
      cerrar();
    });
    panel.addEventListener('click', (e) => {
      if (e.target === panel) cerrar();
    });
    // Cerrar el panel devuelve el foco a la píldora; por eso el salto se hace después, de forma explícita
    panel.querySelectorAll<HTMLAnchorElement>('a').forEach((a) =>
      a.addEventListener('click', (e) => {
        e.preventDefault();
        const id = a.getAttribute('href')!.slice(1);
        panel.classList.remove('cerrando');
        panel.close();
        setTimeout(() => {
          if (!id) return window.scrollTo({ top: 0 });
          document.getElementById(id)?.scrollIntoView();
          history.replaceState(null, '', `#${id}`);
        }, 0);
      }),
    );

    // Votación que se está leyendo: se marca en los dos índices y en la píldora («5 de 27»)
    const enlaces = [...document.querySelectorAll<HTMLAnchorElement>('.indice-lateral a, .panel a[data-indice]')];
    const observador = new IntersectionObserver(
      (entradas) => {
        for (const e of entradas) {
          if (!e.isIntersecting) continue;
          enlaces.forEach((a) => (a.dataset.indice === e.target.id ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
          const v = visibles();
          posicion.textContent = `${v.indexOf(e.target as HTMLElement) + 1} de ${v.length}`;
        }
      },
      { rootMargin: '-30% 0px -60% 0px' },
    );
    items.forEach((li) => observador.observe(li));
    signal.addEventListener('abort', () => observador.disconnect());
  }
  document.addEventListener('astro:page-load', iniciar);
  iniciar();
</script>

<style>
  h1 em { font-style: italic; }
  .entradilla { font-size: var(--entradilla); max-width: 38ch; margin: 0 0 12px; }
  .nota { font-size: 14px; margin: 10px 0 0; }

  /* Filtro de temas fijo arriba mientras se recorre la lista */
  .temas { position: sticky; top: 0; z-index: 5; display: flex; gap: 8px; overflow-x: auto; margin: 12px -20px 0; padding: 10px 20px; background: var(--papel); border-bottom: 1px solid var(--linea); scrollbar-width: none; }
  .temas::-webkit-scrollbar { display: none; }
  .temas button {
    flex: none;
    min-height: 44px;
    font: inherit;
    font-size: 14px;
    padding: 8px 14px;
    border-radius: 999px;
    border: 1px solid var(--linea);
    background: transparent;
    color: var(--tinta);
    cursor: pointer;
    transition: background-color 0.15s, color 0.15s;
  }
  .temas button[aria-pressed='true'] { background: var(--tinta); color: var(--papel); border-color: var(--tinta); }

  .derogados { margin: 14px 0 0; font-size: 15px; }
  .derogados summary { cursor: pointer; padding: 10px 0; }
  .derogados ul { list-style: none; margin: 6px 0 0; padding: 0; }
  .derogados li { padding: 8px 0; border-bottom: 1px solid var(--linea); font-size: 14px; }

